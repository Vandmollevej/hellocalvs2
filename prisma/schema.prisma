generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Account ---

model User {
  id          String   @id @default(cuid())
  // docs/PRIVACY.md: almindelige brugere har INGEN klartekst-e-mail og intet
  // navn på serveren. email bruges kun af admin/personale; brugere findes via
  // emailHash (HMAC-SHA256 med EMAIL_HASH_PEPPER, src/lib/email-hash.ts).
  // displayName er tom for almindelige brugere — navnet ligger i boksen.
  email       String?  @unique
  emailHash   String?  @unique
  displayName String   @default("")
  role        Role     @default(USER)
  weightKg    Float?
  heightCm    Float?
  // Fuld fødselsdato (erstatter det tidligere kun-årstal-felt birthYear pr.
  // 2026-09-19), så alderen kan beregnes præcist og opdateres automatisk år
  // for år i stedet for kun "indeværende år minus fødselsår". Se src/lib/age.ts.
  birthDate   DateTime?
  sex         Sex?
  // Målvægt: brugerens eget mål, sat via /profile/target-weight. Adskilt fra
  // weightKg (start-vægt, låst felt) og weight_entries (løbende vejninger).
  targetWeightKg Float?
  // Tidspunkt for seneste e-mailverificerede ændring af start-vægten
  // (/profile/start-weight). Null = aldrig ændret; så gælder createdAt.
  startWeightUpdatedAt DateTime?
  createdAt   DateTime @default(now())

  // Admin login (docs/ADMIN.md): only set for the single administrator
  // account, created via /admin/setup. Regular users have no login yet
  // (see docs/STATUS.md "Next work" #4), so both fields are null for them.
  passwordHash String?
  totpSecret   String?

  // Regular user signup via /signup (email + password).
  // emailVerifiedAt is set immediately on creation, because SMTP is not
  // yet set up to send a real verification email — see docs/STATUS.md
  // "Next work" for the task of retrofitting the real verification
  // email once SMTP exists.
  emailVerifiedAt DateTime?

  // Sleep pattern: default bedtime/wake time, with the option of
  // individual times per weekday (SleepSchedule) for users with shifting
  // work hours.
  defaultBedtime   String?
  defaultWakeTime  String?
  shiftWorkEnabled Boolean @default(false)

  // Shifting work hours: does the user prefer to log work hours or sleep
  // times daily (asked in the setup wizard, only relevant when
  // shiftWorkEnabled is true).
  dailyLogPreference DailyLogPreference?

  // Whether the user wants to be able to log work hours directly in the
  // calendar.
  workHoursInCalendarEnabled Boolean @default(false)

  // Has the user asked to have smartwatch/health app import set up.
  // The integration itself (Apple Health/Google Health Connect/Fitbit) is
  // separate, later work — this field only remembers the wish from the
  // wizard.
  healthImportRequested Boolean @default(false)

  // Full-screen setup wizard at first login (docs/UI.md "Onboarding and
  // help"). onboardingStep is the next step to show on resume.
  onboardingStep          Int       @default(0)
  onboardingCompletedAt   DateTime?
  onboardingRemindLaterAt DateTime?
  onboardingDismissed     Boolean   @default(false)

  // Personal settings, non-default "Show allergens" (see docs/STATUS.md
  // "Details" extension): master switch plus which of the 14 EU allergens
  // (see src/lib/allergens.ts) the user wants shown when a product contains
  // them. Null = all are shown, when showAllergens is true.
  showAllergens      Boolean @default(false)
  allergenVisibility Json?

  // Personal setting (2026-09-11): shows the MyFitnessPal-style extended
  // nutrition panel (saturated/unsaturated/trans fat, cholesterol, sodium,
  // potassium, fibre, sugar, vitamin A/C, calcium, iron) as a collapsed
  // "Vis mere" section below the normal nutrition table on the add-product
  // screen. Off by default — see design.md's product-detail contract.
  showExtendedNutrition Boolean @default(false)

  // Statistics display preference (2026-09-19): when enabled, a stat card
  // that a separately validated, region/profile-aware recommendation
  // evaluator has marked as outside the applicable normal range gets a
  // 1 px dark-red stroke (see StatCardsGrid.tsx). No warning is ever
  // inferred from missing data, and this app does not yet ship such an
  // evaluator — see src/lib/stat-cards.ts's StatCardValue.outsideRecommendedRange.
  warnOnRecommendedLimits Boolean @default(false)

  // Region (ISO 3166-1 alpha-2), used to prioritize product search results
  // by the country's GS1 barcode prefix (see src/lib/regions.ts). Denmark is
  // the default, since it's the app's primary market.
  region String @default("DK")

  // End-user app UI language (i18n, added 2026-09-02): "da" (default) or
  // "en". Every existing user defaults to Danish so nothing changes unless
  // they open the language setting in Settings. Kept distinct from the
  // admin-only `locale` enum field below (different feature, different
  // value domain).
  appLocale String @default("da")

  // Billede-dagbog (docs/STATUS.md 2026-09-02): rent klient-lagret
  // foto-sammenligning i dag (localStorage), men adgangs-præferencen skal
  // være autoritativ i databasen. OS-niveau adgangskode-håndhævelse er en
  // fremtidig native-app-opgave — dette felt er kun den gemte brugerpræference.
  photoDiaryRequiresPasscode Boolean @default(false)

  // Kommunikationspræferencer (docs/STATUS.md 2026-09-02).
  wantsPushNotifications   Boolean @default(false)
  wantsUpdateNewsEmails    Boolean @default(false)
  wantsAdviceEmails        Boolean @default(false)
  wantsPartnerOffersEmails Boolean @default(false)

  // "Invitér en ven": kort delbar kode brugt i invite-linket
  // (https://.../tilmeld?ref=<referralCode>). Belønning er 300 points til
  // både afsender og ny bruger ved gennemført tilmelding (PointsReason
  // FRIEND_REFERRAL), IKKE en direkte gratis måned — se Referral-modellen.
  referralCode String @unique @default(cuid())

  // Lifetime-loft: maks. 12 gratis måneder nogensinde, uanset om de kommer
  // fra "invitér en ven" (300 points/stk.) eller anden fremtidig kilde.
  // Forhøjes kun via 300-points-indløsning (PointsReason FREE_MONTH_REDEEMED),
  // se src/lib/points.ts.
  freeMonthsCredited Int @default(0)

  // Admin-UI-sprog (kun relevant for role=ADMIN, men fælles felt er enklere
  // end en separat admin-only tabel).
  locale Locale @default(DA)

  // GDPR "ret til at blive glemt" (docs/DECISIONS.md 2026-09-02): sat når en
  // admin har anonymiseret kontoen. Historiske Registration-rækker bevares
  // (snapshot-princippet), men PII er ryddet — se src/lib/gdpr.ts.
  forgottenAt DateTime?

  // Krydsspærring for "videresend til en ven" (docs/DECISIONS.md, points-
  // system 2026-09-02): sat når to brugere har sendt mere end én tur-retur
  // videresendelse til hinanden inden for 24 timer. Blokerer nye points fra
  // FRIEND_FORWARD_FULFILLED for begge brugere, indtil admin rydder flaget
  // fra Advarsler-siden.
  forwardAbuseFlaggedAt DateTime?

  // Menstruationscyklus (docs/DECISIONS.md 2026-09-19): kun relevant/vist når
  // sex = FEMALE. cycleTrackingEnabled er den "Vis menstruationscyklus"-
  // slåknap under Indstillinger → Visning (default fra, samme "vis aldrig
  // som standard"-konvention som showAllergens/showExtendedNutrition) — når
  // den er slået til, kan cyklus logges fra tilføj-menuen (src/lib/add-actions.ts)
  // og logges i MenstrualCycleEntry. De to gennemsnit bruges kun til en
  // simpel fremtidig prognose, ikke til noget klinisk.
  cycleTrackingEnabled    Boolean @default(false)
  averageCycleLengthDays  Int     @default(28)
  averagePeriodLengthDays Int     @default(5)

  registrations           Registration[]
  favorites               Favorite[]
  dishes                  Dish[]
  weightEntries           WeightEntry[]
  bodyMeasurements        BodyMeasurement[]
  goals                   Goal[]
  waterEntries            WaterEntry[]
  menstrualCycleEntries   MenstrualCycleEntry[]
  sleepSchedules          SleepSchedule[]
  workShifts              WorkShift[]
  integrations            Integration[]
  activities              Activity[]
  deviceTokens            DeviceToken[]
  healthMetrics           HealthMetric[]
  passkeys                Passkey[]
  keyEnvelopes            KeyEnvelope[]
  recoveryShare           RecoveryShare?
  recoveryRequests        RecoveryRequest[]        @relation("RecoveryRequestUser")
  recoveryRequestsApproved RecoveryRequest[]       @relation("RecoveryRequestApprover")
  inviteLinks             InviteLink[]
  inviteRewards           InviteReward[]
  referralsMade           Referral[]               @relation("ReferralsMade")
  referralReceived        Referral?                @relation("ReferralReceived")
  sentInvitations         SentInvitation[]
  pointsTransactions      PointsTransaction[]
  bugReports              BugReport[]
  notificationPreferences NotificationPreference[]
  pushSubscriptions       PushSubscription[]
  forwardsSent            Forward[]                @relation("ForwardSender")
  outboundMessages        OutboundMessage[]
  doctorShares            DoctorShare[]
  subscription            Subscription?
  paymentMethods          PaymentMethod[]
  giftCodesRedeemed       GiftCode[]
  adminAuditLogsAsActor   AdminAuditLog[]          @relation("AdminAuditActor")
  adminAuditLogsAsTarget  AdminAuditLog[]          @relation("AdminAuditTarget")
  // Support (docs/DECISIONS.md 2026-09-23): brugerens egne, tidsbegrænsede
  // tilladelser til Support + brugerens henvendelser til Support.
  supportAccessGrants     SupportAccessGrant[]
  supportRequests         SupportRequest[]
  productsCreated         Product[]                @relation("ProductsCreatedByUser")
  passwordResetTokens     PasswordResetToken[]
  startWeightChangeTokens StartWeightChangeToken[]
  genericIngredientsCreated GenericIngredient[]     @relation("GenericIngredientsCreatedByUser")
  searchRankingConfigsCreated SearchRankingConfig[]
  // Personal search/click history (2026-09-19, see docs/DECISIONS.md) — feeds
  // the Søgealgoritmer "Personligt tidligere søgte produkter" weight. Erased
  // by anonymizeUser() (src/lib/gdpr.ts), same as every other per-user table.
  productSearchHistory    UserProductSearchHistory[]
  nutritionReportsReviewed ProductNutritionReport[] @relation("NutritionReportReviewer")

  @@map("users")
}

// "Invitér en ven"-bogføring. Attribueres ved tilmelding via
// User.referralCode i invite-linket (src/app/api/auth/register/route.ts).
// Belønning (docs/DECISIONS.md 2026-09-02): 300 points til BÅDE referrer og
// referredUser, tildelt af src/lib/referrals.ts når referredRegisteredAt er
// ≥3 måneder gammel (uændret ventetid-regel). Points indløses separat til
// gratis måneder (300 points = 1 måned, kræver gemt betalingsmetode så
// abonnementet fortsætter automatisk bagefter) — se PointsReason
// FREE_MONTH_REDEEMED og src/app/profile/points/page.tsx.
model Referral {
  id                   String    @id @default(cuid())
  referrer             User      @relation("ReferralsMade", fields: [referrerId], references: [id])
  referrerId           String
  referredUser         User      @relation("ReferralReceived", fields: [referredUserId], references: [id])
  referredUserId       String    @unique
  referredRegisteredAt DateTime
  rewardGrantedAt      DateTime?

  @@map("referrals")
}

// Fejlretninger/FEJLLISTE.md #12D: sporer selve invitations-e-mailen, adskilt
// fra Referral (som først findes, når modtageren rent faktisk opretter en
// konto). En invitation er gyldig 1 uge og kan gensendes (bumper sentAt/
// expiresAt og genkøer beskeden i stedet for at oprette en ny række).
model SentInvitation {
  id         String    @id @default(cuid())
  inviter    User      @relation(fields: [inviterId], references: [id])
  inviterId  String
  email      String
  sentAt     DateTime  @default(now())
  expiresAt  DateTime
  acceptedAt DateTime?

  @@index([inviterId])
  @@map("sent_invitations")
}

enum Role {
  USER
  ADMIN
}

// Admin-UI-sprog (docs/DECISIONS.md 2026-09-02).
enum Locale {
  DA
  EN
}

enum Sex {
  FEMALE
  MALE
}

enum DailyLogPreference {
  WORK_HOURS
  SLEEP_TIMES
}

// WebAuthn/passkey credentials for the admin login (docs/ADMIN.md) —
// alternative to password + TOTP, e.g. Face ID on iPhone via iCloud Keychain.
// A successful passkey assertion already proves possession + biometric user
// verification, so it grants a full session directly (no separate TOTP step).
model Passkey {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id])
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]  @default([])
  deviceType   String?
  backedUp     Boolean   @default(false)
  name         String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@map("passkeys")
}

// Password-reset via tidsbegrænset, éngangs e-mail-link (docs/SPECIFICATION.md:37).
// Kun tokenets hash gemmes (samme mønster som DeviceToken.tokenHash) — den
// rå værdi findes kun i selve reset-linket, som brugeren modtager på mail.
// usedAt sættes ved forbrug, så et allerede-brugt link ikke kan genbruges.
model PasswordResetToken {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// Engangslink til ændring af den låste start-vægt (docs/DECISIONS.md
// 2026-09-22). Kun hash gemmes — samme mønster som PasswordResetToken.
model StartWeightChangeToken {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("start_weight_change_tokens")
}

// --- Weight calibration ---
// Several weekly weigh-ins under different conditions (clothing, time of
// day, toilet/food) give the user a sense of the fluctuation throughout the
// day, without requiring them to always weigh themselves naked in order to
// compare.

model WeightEntry {
  id        String       @id @default(cuid())
  user      User         @relation(fields: [userId], references: [id])
  userId    String
  weightKg  Float
  clothed   Boolean      @default(true)
  shoes     ShoesState   @default(UNKNOWN)
  toilet    RelativeTime @default(UNKNOWN)
  meal      RelativeTime @default(UNKNOWN)
  timeOfDay TimeOfDay    @default(UNKNOWN)
  // Where the weigh-in comes from. An active weight integration automatically
  // overwrites the latest value (docs/SPECIFICATION.md:47) — scale sources
  // can't know the clothing/shoes/toilet/food state, so those fields stay
  // UNKNOWN/true (default) for rows written by an integration.
  source    WeightSource @default(MANUAL)
  note      String?
  weighedAt DateTime     @default(now())

  @@map("weight_entries")
}

enum RelativeTime {
  BEFORE
  AFTER
  UNKNOWN
}

enum TimeOfDay {
  MORNING
  EVENING
  UNKNOWN
}

enum ShoesState {
  ON
  OFF
  UNKNOWN
}

enum WeightSource {
  MANUAL
  FITBIT
  WITHINGS
  APPLE_HEALTH
  GOOGLE_HEALTH
}

// --- Body measurements ---
// Kropsmål ved siden af vægt (2026-09-12): de mål, en diætist typisk følger
// ud over vægten for at vurdere kropssammensætning over tid, uafhængigt af
// selve indtastningssiden (den bygges i en separat session, se
// docs/STATUS.md). Alle felter er valgfrie omkredsmål i cm, så en bruger kan
// registrere kun de mål, vedkommende selv måler.

model BodyMeasurement {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  waistCm      Float?
  hipCm        Float?
  chestCm      Float?
  thighCm      Float?
  upperArmCm   Float?
  note         String?
  measuredAt   DateTime @default(now())

  @@index([userId, measuredAt])
  @@map("body_measurements")
}

// --- Målsætninger ---
// Historiske, daterede målsætninger (2026-09-22): én Goal pr. gang brugeren
// trykker "Opret ny målsætning", med ét GoalTarget pr. udfyldt felt (vægt
// og/eller et BodyMeasurement-felt). Rækker slettes/overskrives aldrig, så
// historikken bevares. User.targetWeightKg holdes i sync med den nyeste
// vægt-target, fordi Hello Doc m.fl. stadig læser det felt.

enum GoalDirection {
  INCREASE
  DECREASE
  MAINTAIN
}

model Goal {
  id        String       @id @default(cuid())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime     @default(now())
  // Kalenderdatoen, målsætningen ønskes nået (2026-09-23). Gemmes kl. 12:00
  // UTC, så datoen ikke skifter ved tidszonekonvertering. Null for ældre
  // målsætninger (bl.a. backfill fra User.targetWeightKg).
  targetDate DateTime?
  targets   GoalTarget[]

  @@index([userId, createdAt])
  @@map("goals")
}

model GoalTarget {
  id          String         @id @default(cuid())
  goal        Goal           @relation(fields: [goalId], references: [id], onDelete: Cascade)
  goalId      String
  // "weight" eller et BodyMeasurement-feltnavn ("waistCm", "hipCm", …), jf.
  // src/lib/body-measurements.ts.
  type        String
  value       Float
  unit        String
  // Seneste registrerede værdi ved oprettelsen; afgør retningen, så systemet
  // aldrig skal gætte, om brugeren ville op eller ned. Null indtil første
  // måling, hvis der ikke fandtes nogen historik.
  startValue  Float?
  direction   GoalDirection?
  // Sættes én gang, når en måling efter oprettelsen når målet, og ryddes
  // aldrig igen — historikken skal vise, at målet på et tidspunkt blev nået.
  completedAt DateTime?

  @@unique([goalId, type])
  @@map("goal_targets")
}

// Manual water intake logging (docs/STATUS.md roadmap note, 2026-09-12: a
// dedicated FAB action for "VAND"). Each row is one logged amount (a bottle
// or glass), not a per-day aggregate — unlike BodyMeasurement, there is no
// same-day merge; the day's total is the sum of that day's rows.
model WaterEntry {
  id       String   @id @default(cuid())
  user     User     @relation(fields: [userId], references: [id])
  userId   String
  amountMl Float
  loggedAt DateTime @default(now())

  @@index([userId, loggedAt])
  @@map("water_entries")
}

// Menstruationscyklus (docs/DECISIONS.md 2026-09-19): logges via /period/create
// (kun tilgængelig for kvinder, se User.cycleTrackingEnabled/sex ovenfor).
// En række pr. registreret periode; endDate er valgfri (kan tilføjes/rettes
// senere, når perioden er slut).
model MenstrualCycleEntry {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, startDate])
  @@map("menstrual_cycle_entries")
}

// --- Sleep pattern and shifting work hours ---
// Individual bedtimes/wake times per weekday. Only used when the user has
// enabled "individual times"; otherwise User.defaultBedtime/-WakeTime applies.

model SleepSchedule {
  id       String @id @default(cuid())
  user     User   @relation(fields: [userId], references: [id])
  userId   String
  weekday  Int // 0 = Monday … 6 = Sunday
  bedtime  String
  wakeTime String

  @@unique([userId, weekday])
  @@map("sleep_schedules")
}

// Work days/hours logged directly in the calendar (e.g. shift work/
// night work). bedtime/wakeTime is an optional sleep override for that
// date, used in the calendar's sleep visualization when shiftWorkEnabled
// is on.

model WorkShift {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  date      DateTime @db.Date
  startTime String?
  endTime   String?
  bedtime   String?
  wakeTime  String?
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@map("work_shifts")
}

// --- Health integrations ---
// Fitbit and Withings have real OAuth APIs and store their connection in
// the Integration table. Garmin is pending separate partner approval and is
// only shown statically in the UI. Apple Health/Google Health Connect can't
// be accessed from a web app at all (HealthKit/Health Connect are
// native-only) — instead a generic ingestion path (DeviceToken +
// HealthMetric) has been prepared, which a future native companion app can
// send data to; see docs/HEALTHKIT_COMPANION.md and docs/DECISIONS.md
// (2026-08-28).

model Integration {
  id           String              @id @default(cuid())
  user         User                @relation(fields: [userId], references: [id])
  userId       String
  provider     IntegrationProvider
  status       IntegrationStatus   @default(DISCONNECTED)
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  scope        String?
  connectedAt  DateTime?
  lastSyncedAt DateTime?
  lastError    String?
  // docs/PRIVACY.md: hentede data forsegles straks til denne indbakke
  // (VaultInbox.id). Serveren gemmer dem aldrig i klartekst.
  inboxId      String?
  createdAt    DateTime            @default(now())

  @@unique([userId, provider])
  @@map("integrations")
}

enum IntegrationProvider {
  FITBIT
  WITHINGS
  GARMIN
  APPLE_HEALTH
  GOOGLE_HEALTH
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

// Sports/activity logs, entered manually or fetched from a connected
// Integration. Used for the calendar's sports icon/bonus calories and the
// statistics page's sport blocks (docs/SPECIFICATION.md §5 "Calorie bank").
model Activity {
  id              String         @id @default(cuid())
  user            User           @relation(fields: [userId], references: [id])
  userId          String
  source          ActivitySource @default(MANUAL)
  sportType       String
  startedAt       DateTime
  durationMinutes Int
  caloriesBurned  Float
  createdAt       DateTime       @default(now())

  @@map("activities")
}

enum ActivitySource {
  MANUAL
  FITBIT
  GARMIN
  APPLE_HEALTH
  GOOGLE_HEALTH
}

// A personal, long-lived access token a future native companion app
// (iOS/HealthKit or Android/Health Connect) authenticates with against
// POST /api/integrations/healthkit/ingest. Only the token's hash is
// stored — the raw value is shown once at creation, like a personal
// API-key pattern.
model DeviceToken {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  tokenHash  String    @unique
  label      String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  // docs/PRIVACY.md: indsendte data forsegles til denne indbakke.
  inboxId    String?

  @@map("device_tokens")
}

// Generic health metrics from a connected native companion app, for
// data types that don't fit in WeightEntry/Activity (steps, heart rate,
// sleep, body fat, height, BMI, etc.). See docs/HEALTHKIT_COMPANION.md.
model HealthMetric {
  id         String             @id @default(cuid())
  user       User               @relation(fields: [userId], references: [id])
  userId     String
  source     HealthMetricSource
  type       HealthMetricType
  value      Float
  recordedAt DateTime
  createdAt  DateTime           @default(now())

  @@unique([userId, source, type, recordedAt])
  @@map("health_metrics")
}

enum HealthMetricSource {
  APPLE_HEALTH
  GOOGLE_HEALTH
  // 2026-09-19: added for the Statistik "Sport og aktivitet"/"Søvn"
  // expansion (src/lib/stat-cards.ts) — same prepared-ahead-of-time pattern
  // as the rest of this enum; no sync job exists for these yet.
  FITBIT
  WITHINGS
  GARMIN
}

enum HealthMetricType {
  STEPS
  ACTIVE_ENERGY_KCAL
  RESTING_ENERGY_KCAL
  HEART_RATE_BPM
  SLEEP_MINUTES
  BODY_FAT_PERCENT
  HEIGHT_CM
  BMI
  WATER_ML
  // 2026-09-19: "Kilometer bevæget", front-page number-slider (see
  // src/lib/frontpage-stats.ts). No source sends this yet — same
  // prepared-ahead-of-time pattern as the rest of this enum (docs/DECISIONS.md
  // 2026-08-28 HealthKit/Health Connect companion-app entry): once a future
  // native companion app syncs a smartwatch's distance, it lands here.
  DISTANCE_KM

  // 2026-09-19: Statistik "Sport og aktivitet"/"Søvn" expansion
  // (src/lib/stat-cards.ts) — same prepared-ahead-of-time pattern as
  // DISTANCE_KM above. No source sends any of these yet; every card falls
  // back to "—", never a fabricated sample value.
  EXERCISE_MINUTES
  STAND_MINUTES
  FLOORS_CLIMBED
  ACTIVE_ZONE_MINUTES
  RESTING_HEART_RATE_BPM
  RESTING_HEART_RATE_MINUTES
  HEART_RATE_MIN_BPM
  HEART_RATE_MAX_BPM
  HEART_RATE_VARIABILITY_MS
  VO2_MAX
  HEART_RATE_RECOVERY_BPM
  RESPIRATORY_RATE_BPM
  OXYGEN_SATURATION_PERCENT
  TEMPERATURE_C
  STRESS_SCORE
  EDA_RESPONSES
  CARDIO_LOAD

  // Sleep detail (Statistik "Søvn" section). SLEEP_MINUTES above stays the
  // existing total-sleep-duration metric; these are its breakdown.
  SLEEP_IN_BED_MINUTES
  SLEEP_START_MINUTE_OF_DAY
  SLEEP_END_MINUTE_OF_DAY
  SLEEP_AWAKE_MINUTES
  SLEEP_REM_MINUTES
  SLEEP_LIGHT_MINUTES
  SLEEP_DEEP_MINUTES
  SLEEP_SCORE
  SLEEP_EFFICIENCY_PERCENT
  SLEEP_AWAKENINGS

  // Micronutrients (Statistik "Mineraler"/"Vitaminer" groups), shown with
  // periodic-table icons (public/icons/minerals) in StatCardsGrid.tsx.
  SODIUM_MG
  MAGNESIUM_MG
  ZINC_MG
  COPPER_MG
  MANGANESE_MG
  SELENIUM_UG
  PHOSPHORUS_MG
  IODINE_UG
  CHROMIUM_UG
  MOLYBDENUM_UG
  VITAMIN_D_UG
  VITAMIN_E_MG
  VITAMIN_K_UG
  VITAMIN_B1_MG
  VITAMIN_B2_MG
  VITAMIN_B3_MG
  VITAMIN_B5_MG
  VITAMIN_B6_MG
  VITAMIN_B7_UG
  VITAMIN_B9_UG
  VITAMIN_B12_UG
  // 2026-09-23: Mineraler group — same prepared-ahead-of-time pattern, no
  // source sends these yet.
  CHLORIDE_MG
  FLUORIDE_MG
}

// --- Food database ---

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  logoUrl   String?
  createdAt DateTime  @default(now())
  products  Product[]
  regionSearchStats BrandRegionSearchStat[]

  @@map("brands")
}

// Region-scoped popularity of a Brand rather than a single Product — feeds
// the Søgealgoritmer admin page's "Region-specifikke brands/mærker" weight
// (docs/DECISIONS.md, 2026-09-19). Same aggregate-only shape as
// ProductRegionSearchStat; incremented alongside a product's own region stat
// whenever the searched/clicked product has a brand.
model BrandRegionSearchStat {
  brand          Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId        String
  region         String
  searchCount    Int       @default(0)
  clickCount     Int       @default(0)
  lastSearchedAt DateTime?
  lastClickedAt  DateTime?

  @@id([brandId, region])
  @@index([region, searchCount])
  @@index([region, clickCount])
  @@map("brand_region_search_stats")
}

// Admin-tunable search-ranking weights (docs/DECISIONS.md, 2026-09-19,
// "Søgealgoritmer"-adminside). Every commit inserts a new row instead of
// overwriting one, so past settings are never lost — the admin page's
// backup/"Gendan" requirement is just re-committing an older row's weights.
// Exactly one row has isActive=true at a time. DEFAULT_SEARCH_RANKING_WEIGHTS
// in src/lib/product-search-ranking.ts applies whenever no row is active or
// the database is unreachable, so an un-migrated/empty table changes nothing.
model SearchRankingConfig {
  id          String   @id @default(cuid())
  weights     Json
  isActive    Boolean  @default(false)
  note        String?
  createdAt   DateTime @default(now())
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  @@index([isActive])
  @@map("search_ranking_configs")
}

// Pure cataloging categories (not shown in the UI) that make it easier to
// scan/filter the food database internally: "Retter" (dishes, e.g. HelloFresh
// recipes imported as Product), "Menuer" (menus, weekly menu groupings, not
// yet populated — HelloFresh doesn't expose a stable weekly grouping
// publicly), "Ingredienser" (ingredients, the shared Ingredient catalog, see
// below) and "Færdigmad" (ready meals, purchased ready meals, not yet
// auto-tagged). See docs/DECISIONS.md (2026-08-29, HelloFresh import).
model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
  dishes   Dish[]

  @@map("categories")
}

model Product {
  id               String                 @id @default(cuid())
  name             String
  brand            Brand?                 @relation(fields: [brandId], references: [id])
  brandId          String?
  category         Category?              @relation(fields: [categoryId], references: [id])
  categoryId       String?
  imageUrl         String?
  pendingImageUrl  String?
  imageStatus      ImageStatus            @default(NONE)
  kcalPer100g      Float
  proteinPer100g   Float
  carbsPer100g     Float
  fatPer100g       Float
  servingSizeGrams Float?
  // Betegnelsen for servingSizeGrams-enheden ("portion"/"portioner",
  // "person"/"personer", "skive"/"skiver" osv.), kun sat når kilden faktisk
  // angiver den. UI må aldrig gætte/hardkode en enhed, når disse er null —
  // se design.md-diskussion 2026-09-08.
  servingSizeUnitSingular String?
  servingSizeUnitPlural   String?
  ingredientsText  String?
  allergens        String[]               @default([])
  additives        String[]               @default([])
  externalSource   ExternalProductSource?
  externalId       String?
  sourceCheckedAt  DateTime?
  // Hidden search-ranking metadata (2026-09-19, see docs/DECISIONS.md). Never
  // shown in end-user UI. A GS1 prefix identifies where the barcode's company
  // prefix was issued, not necessarily where the product was made — used only
  // as a country/market ranking proxy, see inferGs1OriginCountryCode().
  originCountryCode String?
  // Extra nutrition values that don't fit in the fixed per-100g fields above
  // (e.g. HelloFresh recipes' fiber/sugar/salt/potassium/calcium/iron per
  // serving size). See docs/DECISIONS.md (2026-08-29).
  nutritionExtra   Json?

  // Free-text dietary/label claims (2026-09-19, see docs/DECISIONS.md), e.g.
  // { isVegan: "Vegansk", isLactoseFree: "Laktosefri", isSugarFree: "Sukkerfri" }.
  // Deliberately free text, not booleans: a single claim like "Økologisk"
  // triggers a specific label, and equivalents vary across the ~17 markets
  // this must eventually cover, so a fixed set of typed columns doesn't fit
  // yet. Source of the shelf/fridge-photo dietary overlay feature. Revisit as
  // typed columns once the exact tag taxonomy stabilizes.
  dietaryTags      Json?

  // MyFitnessPal-style extended nutrition panel, per 100g, added 2026-09-11.
  // Only Open Food Facts currently supplies these (see src/lib/openFoodFacts.ts) —
  // null on every other product/source until a matching source is wired up.
  // Only shown in the UI when User.showExtendedNutrition is on (see design.md).
  saturatedFatPer100g   Float?
  unsaturatedFatPer100g Float?
  transFatPer100g       Float?
  cholesterolPer100g    Float? // mg
  vitaminAPer100g       Float? // µg (retinol activity equivalents)
  vitaminCPer100g       Float? // mg

  // Alternative kalorievisninger fra selve emballagens næringsdeklaration
  // (fx "per glas (25 ml)", "per skive", "per stk."), ikke kun pr. 100 g/
  // vægt/mængde — se docs/DECISIONS.md 2026-09-19. Udtrækkes allerede af
  // /api/ai/extract-nutrition-v2 (NutritionAnalysis.alternativeServings,
  // src/lib/product-analysis-types.ts) men blev tidligere kasseret ved
  // produktoprettelse; nu gemt som JSON: array af
  // { label, amount, unit, kcal, confidence, needsReview }. Vises kun for
  // brugeren når confidence er høj nok (se src/lib/alternative-servings.ts);
  // usikre fund sendes i stedet til admin som en AI-genereret fejlrapport
  // (BugReport.source = AI) i stedet for at blive gættet eller vist forkert.
  alternativeServings Json?

  status           ProductStatus          @default(PENDING)
  discontinued     Boolean                @default(false)
  createdAt        DateTime               @default(now())

  // Login-frit admin-godkendelseslink (points-system 2026-09-02, se
  // docs/DECISIONS.md): unikt token brugt i mail-varsler, så admin kan
  // godkende/afvise direkte fra en mail uden at logge ind. Sættes til null
  // igen, når produktet er godkendt/afvist, så linket ikke kan genbruges.
  approvalToken    String?   @unique
  // Sat når 48-timers eskaleringsvarslet er lagt i besked-køen for et
  // produkt der stadig er PENDING, så det ikke sendes flere gange.
  escalationSentAt DateTime?

  // Hvem der indsendte produktet (null for AI/API/DB-autoimporterede
  // produkter, se externalSource, og for produkter oprettet før dette felt
  // fandtes). Bruges til: (1) at adskille bruger-indsendte fra
  // auto-importerede i admin-fanerne, (2) at vide hvem der skal have points
  // ved godkendelse — se src/app/api/admin/products/[id]/approve/route.ts.
  createdBy       User?   @relation("ProductsCreatedByUser", fields: [createdByUserId], references: [id])
  createdByUserId String?

  // Barcode-first guidet AI-produktoprettelse (2026-09-17, se
  // docs/DECISIONS.md): forsidefotoet skelner eksplicit mellem hovedmærke
  // (brand, allerede en relation ovenfor), produktserie (subbrand), selve
  // varen (name) og smag/type/styrke (variant), samt synlig pakningsstørrelse.
  subbrand        String?
  variant         String?
  packageSizeText String?
  // Produkttype = navneord for selve varen (fx "Skyr"), læst af AI eller
  // importeret fra Excel. Manuelt oprettede produkter sammensætter name af
  // Sub brand + Produkttype + Variant (docs/DECISIONS.md 2026-09-23).
  productType     String?

  barcodes           Barcode[]
  // Normaliserede søge-/ernæringsparametre (fiber-%, sukker-%, fuldkorn …),
  // docs/DECISIONS.md 2026-09-23. Højst én række pr. produkt.
  nutritionFeatures  ProductNutritionFeatures?
  registrations      Registration[]
  favorites          Favorite[]
  dishIngredients    DishIngredient[]
  ingredients        ProductIngredient[]
  images             ProductImage[]
  pointsTransactions PointsTransaction[]
  forwards           Forward[]
  duplicateLinksAsA  ProductDuplicateLink[] @relation("ProductDuplicateLinkA")
  duplicateLinksAsB  ProductDuplicateLink[] @relation("ProductDuplicateLinkB")
  aiAnalyses         AiProductAnalysis[]
  matchChecks        ProductMatchCheck[]
  photoAwards        ProductPhotoAward[]
  regionSearchStats  ProductRegionSearchStat[]
  regionHourStats    ProductRegionHourStat[]
  bugReports         BugReport[]
  genericIngredientsMatched GenericIngredient[]
  stores             ProductStore[]
  personalSearchHistory UserProductSearchHistory[]
  nutritionReports   ProductNutritionReport[]

  @@index([externalSource, externalId])
  @@map("products")
}

// Chain-level "found in this store" tagging (2026-09-19, see
// docs/DECISIONS.md). Chain granularity only (e.g. "Rema 1000", "Netto"), not
// individual physical stores/GPS — feeds the planned shelf/fridge-photo
// dietary overlay, which needs to know which chains carry a product, not
// exactly which branch. A product can be carried by several chains, hence
// the join table rather than a single FK on Product.
model Store {
  id        String         @id @default(cuid())
  name      String         @unique
  products  ProductStore[]
  createdAt DateTime       @default(now())

  @@map("stores")
}

// Bulk-imported products (e.g. REMA1000, see scripts/rema1000-import) default
// to the chain they were scraped from. User-submitted products should link
// themselves to whichever chain the submitter is shopping in at creation
// time once that capture UI exists (not built yet — this table is the
// foundation for it).
model ProductStore {
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId   String
  taggedAt  DateTime @default(now())

  @@id([productId, storeId])
  @@map("product_stores")
}

// Hidden per-region search-ranking statistics for a product (2026-09-19, see
// docs/DECISIONS.md). Aggregate counters only — no user id or raw query text
// is stored. Never exposed in an API response body; used only by
// src/lib/product-search-ranking.ts.
model ProductRegionSearchStat {
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId      String
  region         String
  searchCount    Int       @default(0)
  clickCount     Int       @default(0)
  lastSearchedAt DateTime?
  lastClickedAt  DateTime?

  @@id([productId, region])
  @@index([region, searchCount])
  @@index([region, clickCount])
  @@map("product_region_search_stats")
}

// Same as ProductRegionSearchStat, but bucketed by local hour-of-day (0-23),
// so ranking can weight e.g. "Danmark + 06-10" differently from "Danmark +
// 17-20". Click counts only — impressions aren't bucketed by hour.
model ProductRegionHourStat {
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId     String
  region        String
  hour          Int
  clickCount    Int       @default(0)
  lastClickedAt DateTime?

  @@id([productId, region, hour])
  @@index([region, hour, clickCount])
  @@map("product_region_hour_stats")
}

// One row per AI vision analysis of a guided product-creation photo
// (front/ingredients/nutrition). `prediction` is the AI's raw structured
// output at analysis time; `correction`/`correctedAt`/`productId` are filled
// in when the user saves the product with their own (possibly edited)
// values — see POST /api/products. This is the ground-truth feedback loop
// for prompt/model evals and later fine-tuning (docs/DECISIONS.md,
// 2026-09-17). Images are not duplicated here — they already live on
// Product/ProductImage, and an analysis links to the product instead.
//
// 2026-09-19 (quality control/image-match, see docs/DECISIONS.md): `imageUrl`
// and the new BARCODE kind were added so the guided-flow's barcode/nutrition/
// ingredients photos are actually persisted (they previously were sent
// transiently to OpenAI Vision and never saved anywhere) — this is what the
// local quality-control-agent compares against Product.imageUrl.
model AiProductAnalysis {
  id            String         @id @default(cuid())
  kind          AiAnalysisKind
  barcode       String?
  marketRegion  String?        @map("market_region")
  // GS1 barcode-prefix country candidates — a registration/issuance signal
  // used to prioritize OCR/vision languages, never a confirmed physical
  // production country.
  gs1Regions    String[]       @default([]) @map("gs1_regions")
  languages     String[]       @default([])
  model         String
  promptVersion String         @map("prompt_version")
  prediction    Json
  correction    Json?
  confidence    Float?
  // The guided-flow photo itself (BARCODE/NUTRITION/INGREDIENTS only — a
  // FRONT analysis has no image here, since the front photo becomes
  // Product.imageUrl directly). Null for analyses created before this field
  // existed.
  imageUrl      String?        @map("image_url")
  product       Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId     String?        @map("product_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  correctedAt   DateTime?      @map("corrected_at")
  matchCheck    ProductMatchCheck?

  @@index([kind, correctedAt])
  @@index([productId])
  @@map("ai_product_analyses")
}

enum AiAnalysisKind {
  FRONT
  INGREDIENTS
  NUTRITION
  BARCODE
}

// Kvalitetskontrol / billed-match (2026-09-19, se docs/DECISIONS.md): en
// lokal (ikke-OpenAI) billedanalyse-agent (scripts/quality-control-agent)
// sammenligner et produkts stregkode-/næring-/ingrediensfoto
// (AiProductAnalysis.imageUrl) mod dets forsidefoto (Product.imageUrl) og
// beregner en match-confidence. Under 80% confidence stilles til manuel
// admin-gennemgang (aldrig automatisk deaktivering af produktet). Admins
// korrekt/forkert/usikker-afgørelse gemmes permanent som fremtidig
// træningsdata til en senere Hello Cal-specifik model.
model ProductMatchCheck {
  id              String            @id @default(cuid())
  product         Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId       String
  analysis        AiProductAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  analysisId      String            @unique
  photoType       AiAnalysisKind
  // Delresultater, ikke kun én samlet procent — se docs/DECISIONS.md, så
  // vægtningen kan justeres senere uden at genberegne fra bunden.
  visualScore     Float?
  colorScore      Float?
  structuralScore Float?
  confidence      Float?
  status          MatchCheckStatus  @default(PENDING)
  adminVerdict    MatchVerdict?
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())
  award           ProductPhotoAward?

  @@index([productId, status])
  @@index([status, confidence])
  @@map("product_match_checks")
}

// Brugerindberettede ændringer af næringsindhold (docs/DECISIONS.md
// 2026-09-23). Oprettes server-side af POST /api/registrations, når en
// ikke-admin bruger har ændret protein/kulhydrat/fedt via skyderne i forhold
// til produktets egne værdier. Vises i admin "Kvalitetskontrol" sammen med
// ProductMatchCheck-rækkerne. Produktet overskrives KUN ved admin-godkendelse
// (PATCH /api/admin/nutrition-reports/[id]); afvisning ændrer intet på
// produktet. Rækkerne slettes aldrig, så de udgør historikken.
model ProductNutritionReport {
  id               String                @id @default(cuid())
  product          Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId        String
  // Privacy (docs/PRIVACY.md): ingen User- eller Registration-reference —
  // rapporten må ikke afsløre, hvem der har spist varen. I stedet en anonym
  // svaradresse: indberetterens VaultInbox-id (SHA-256 af et token, der kun
  // ligger i brugerens boks). Admin kan forsegle en besked dertil
  // (sealToPublicKey) uden at kunne se, hvem modtageren er. Null, når
  // klienten ikke har en indbakke endnu.
  replyInboxId     String?
  source           FoodChangeSource      @default(USER_EDIT)
  amountGrams      Float
  // Kun de felter der faktisk er ændret, omregnet til pr. 100 g:
  // [{ field: "proteinPer100g", before: 18.4, reported: 20.1 }, ...]
  changes          Json
  confidence       Float
  status           NutritionReportStatus @default(PENDING)
  reviewedBy       User?                 @relation("NutritionReportReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime              @default(now())

  @@index([productId, status])
  @@index([status, createdAt])
  @@map("product_nutrition_reports")
}

enum FoodChangeSource {
  USER_EDIT
}

// PENDING = afventer admin, produktet er uændret.
// APPROVED = admin godkendte, de indberettede værdier er skrevet til produktet.
// REJECTED = admin afviste, produktet er uændret.
enum NutritionReportStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MatchCheckStatus {
  PENDING
  REVIEWED
}

enum MatchVerdict {
  CORRECT
  WRONG
  UNCERTAIN
}

// Point-belønning for at indsende et bedre billede, tilknyttet en konkret
// ProductMatchCheck-problemstilling (docs/DECISIONS.md 2026-09-19). Admin
// sætter selv antal points (ingen fast sats). Det nye billede erstatter
// IKKE automatisk det gamle ved indsendelse — kun når admin godkender det
// (se PATCH /api/admin/quality-control/[id]/award), så systemet forbliver
// selvforstærkende uden at risikere at gemme et dårligere billede.
model ProductPhotoAward {
  id                String       @id @default(cuid())
  matchCheck        ProductMatchCheck @relation(fields: [matchCheckId], references: [id], onDelete: Cascade)
  matchCheckId      String       @unique
  product           Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId         String
  photoType         AiAnalysisKind
  points            Int
  enabled           Boolean      @default(false)
  status            AwardStatus  @default(OPEN)
  submittedImageUrl String?
  submittedByUserId String?
  submittedAt       DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime     @default(now())

  @@index([productId, enabled, status])
  @@map("product_photo_awards")
}

enum AwardStatus {
  OPEN
  SUBMITTED
  RESOLVED
}

// Flags two Product rows created with the same normalized name within a
// short time window (see src/lib/product-duplicates.ts) — i.e. two users (or
// the same user twice, e.g. an offline-queued submission replaying after an
// online one already landed) independently creating "the same" product at
// nearly the same time, as opposed to the older name-only "mulige dubletter"
// list on /admin/warnings. Reviewed on the admin "Dobbeltoprettelser" page,
// which lets the admin pick which images to keep and merge the pair into one
// product (docs/ADMIN.md).
model ProductDuplicateLink {
  id         String                     @id @default(cuid())
  // Always stored with productAId < productBId (string comparison) so the
  // same pair can never be flagged twice regardless of creation order.
  productA   Product                    @relation("ProductDuplicateLinkA", fields: [productAId], references: [id], onDelete: Cascade)
  productAId String
  productB   Product                    @relation("ProductDuplicateLinkB", fields: [productBId], references: [id], onDelete: Cascade)
  productBId String
  status     ProductDuplicateLinkStatus @default(PENDING)
  createdAt  DateTime                   @default(now())
  resolvedAt DateTime?

  @@unique([productAId, productBId])
  @@index([status])
  @@map("product_duplicate_links")
}

enum ProductDuplicateLinkStatus {
  PENDING
  MERGED
  DISMISSED
}

// Up to 3 additional photos alongside the primary Product.imageUrl (e.g. the
// other sides of a milk carton or box). Admin-managed only (docs/ADMIN.md,
// "Merge og øvrige billeder") — the image-agent's automated suggestion flow
// still targets pendingImageUrl/imageStatus above, unrelated to this table.
model ProductImage {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  // Metatags on the individual image, e.g. "Multiple" (shows several items,
  // e.g. several apples) or "Raw" (unprepared/fresh, e.g. raw meat) — see
  // docs/DECISIONS.md 2026-09-19 (image variant tags). Deliberately a free
  // string list, not the product's own field: the same product can have a
  // packaged default photo plus separate tagged variants selected by
  // context (amount, recipe/dish-building) rather than a fixed per-product
  // mapping.
  tags      String[] @default([])
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

enum ExternalProductSource {
  OPEN_FOOD_FACTS
  USDA
  FRIDA
  HELLOFRESH
  REMA1000
}

// Reference database of EU-approved E-number additives (E100-E1521),
// imported from scripts/e-numre/data/e_numre.csv via scripts/e-numre/import_to_db.py.
model Additive {
  eNumber           String   @id @map("e_number")
  internationalName String   @map("international_name")
  danishName        String   @map("danish_name")
  function          String
  risks             String
  research          String
  link              String
  source            String
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("additives")
}

// Which Frida release (DTU's Figshare dataset) was most recently imported,
// so frida-agent (scripts/frida-import) doesn't re-import the same version.
model FridaImportState {
  id                Int      @id @default(autoincrement())
  figshareArticleId Int      @unique
  title             String
  importedAt        DateTime @default(now())

  @@map("frida_import_state")
}

// Shared ingredient image catalog, fetched by hellofresh-agent
// (scripts/hellofresh-import) from HelloFresh's public recipe pages.
// Separate from Product: it's images/metadata for display across the
// app (e.g. "this dish contains: [icon] Carrot"), not a standalone
// loggable food item — Frida-imported Product rows are still the only
// source for actual nutrition values of raw ingredients. See
// docs/DECISIONS.md (2026-08-29).
model Ingredient {
  id             String   @id @default(cuid())
  name           String
  slug           String?
  externalSource String? // "HELLOFRESH"
  externalId     String?  @unique
  imageUrl       String?
  createdAt      DateTime @default(now())

  products ProductIngredient[]
  regionSearchStats IngredientRegionSearchStat[]
  regionHourStats   IngredientRegionHourStat[]
  personalSearchHistory UserProductSearchHistory[]
  images   IngredientImage[]

  @@map("ingredients")
}

// Tagged image variants for an Ingredient — same shape/purpose as
// ProductImage (see its own comment, docs/DECISIONS.md 2026-09-19). The
// existing single Ingredient.imageUrl remains the untagged default.
model IngredientImage {
  id           String     @id @default(cuid())
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  ingredientId String
  url          String
  tags         String[]   @default([])
  order        Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([ingredientId])
  @@map("ingredient_images")
}

// Same shape as ProductRegionSearchStat/ProductRegionHourStat, but for
// ingredients (2026-09-19, see docs/DECISIONS.md).
model IngredientRegionSearchStat {
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  ingredientId   String
  region         String
  searchCount    Int        @default(0)
  clickCount     Int        @default(0)
  lastSearchedAt DateTime?
  lastClickedAt  DateTime?

  @@id([ingredientId, region])
  @@index([region, searchCount])
  @@index([region, clickCount])
  @@map("ingredient_region_search_stats")
}

model IngredientRegionHourStat {
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  ingredientId  String
  region        String
  hour          Int
  clickCount    Int       @default(0)
  lastClickedAt DateTime?

  @@id([ingredientId, region, hour])
  @@index([region, hour, clickCount])
  @@map("ingredient_region_hour_stats")
}

// Generic, non-scanned ingredients (2026-09-19, see docs/DECISIONS.md) —
// fruit/vegetables/meat sold loose with no brand/packaging, so they can never
// go through the barcode/brand-based Product flow. A deliberately separate
// table from Product (own database, per the user's explicit request) and from
// Ingredient above (which is only a HelloFresh recipe-image cache, not a
// loggable item). Displayed through the same /add/[id]-style screen as an
// ordinary Product (via the fallback in /api/products/[id] and the
// genericIngredientId branch on Registration), so the two look identical to
// the user aside from never showing a brand/barcode section.
model GenericIngredient {
  id       String                    @id @default(cuid())
  name     String
  category GenericIngredientCategory @default(OTHER)
  imageUrl String?

  // No packaging means no energideklaration to read — nutrition is resolved
  // once at creation time from the best-matching Frida (DTU) reference
  // product (externalSource="FRIDA", see the 2026-08-27 Frida entry in
  // docs/DECISIONS.md and src/lib/generic-ingredient-match.ts). Copied onto
  // this row (not looked up live every time) so a later Frida re-import can't
  // silently change an already-logged ingredient's numbers. Null/unmatched
  // fields show "–" in the UI rather than inventing a number, same convention
  // as the 2026-09-19 distanceKm field (docs/STATUS.md).
  fridaProduct   Product? @relation(fields: [fridaProductId], references: [id], onDelete: SetNull)
  fridaProductId String?
  kcalPer100g    Float?
  proteinPer100g Float?
  carbsPer100g   Float?
  fatPer100g     Float?

  createdBy       User?    @relation("GenericIngredientsCreatedByUser", fields: [createdByUserId], references: [id])
  createdByUserId String?
  createdAt       DateTime @default(now())

  registrations     Registration[]
  regionSearchStats GenericIngredientRegionSearchStat[]
  regionHourStats   GenericIngredientRegionHourStat[]
  personalSearchHistory UserProductSearchHistory[]
  images            GenericIngredientImage[]

  @@map("generic_ingredients")
}

// Tagged image variants for a GenericIngredient — same shape/purpose as
// ProductImage (see its own comment, docs/DECISIONS.md 2026-09-19). The
// existing single GenericIngredient.imageUrl remains the untagged default.
model GenericIngredientImage {
  id                  String            @id @default(cuid())
  genericIngredient   GenericIngredient @relation(fields: [genericIngredientId], references: [id], onDelete: Cascade)
  genericIngredientId String
  url                 String
  tags                String[]          @default([])
  order               Int               @default(0)
  createdAt           DateTime          @default(now())

  @@index([genericIngredientId])
  @@map("generic_ingredient_images")
}

// Personal per-user search/click history (2026-09-19, see docs/DECISIONS.md
// — explicit user decision overriding the earlier "aggregate/anonymous-only"
// search-stat principle). Feeds the Søgealgoritmer "Personligt tidligere
// søgte produkter" weight, and doubles as the cache the ranking reads
// instead of recomputing personal affinity from Registration/Favorite
// history on every search. Deleted in full by "Ret til at blive glemt"
// (anonymizeUser(), src/lib/gdpr.ts) — never kept past that point.
model UserProductSearchHistory {
  id                  String             @id @default(cuid())
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String
  product             Product?           @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId           String?
  ingredient          Ingredient?        @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  ingredientId        String?
  genericIngredient   GenericIngredient? @relation(fields: [genericIngredientId], references: [id], onDelete: Cascade)
  genericIngredientId String?
  searchCount         Int                @default(0)
  clickCount          Int                @default(0)
  lastSearchedAt      DateTime?
  lastClickedAt       DateTime?

  @@unique([userId, productId])
  @@unique([userId, ingredientId])
  @@unique([userId, genericIngredientId])
  @@index([userId, clickCount])
  @@map("user_product_search_history")
}

enum GenericIngredientCategory {
  FRUIT
  VEGETABLE
  MEAT
  OTHER
}

// Same shape/purpose as ProductRegionSearchStat/IngredientRegionSearchStat,
// but for GenericIngredient — per the user's explicit choice (2026-09-19) to
// reuse the existing search/click-count region-popularity pattern rather than
// a manually curated country list.
model GenericIngredientRegionSearchStat {
  ingredient     GenericIngredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  ingredientId   String
  region         String
  searchCount    Int       @default(0)
  clickCount     Int       @default(0)
  lastSearchedAt DateTime?
  lastClickedAt  DateTime?

  @@id([ingredientId, region])
  @@index([region, searchCount])
  @@index([region, clickCount])
  @@map("generic_ingredient_region_search_stats")
}

// Same as GenericIngredientRegionSearchStat, but bucketed by local
// hour-of-day (0-23) — same shape/purpose as ProductRegionHourStat/
// IngredientRegionHourStat. Click counts only, no impressions.
model GenericIngredientRegionHourStat {
  ingredient    GenericIngredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  ingredientId  String
  region        String
  hour          Int
  clickCount    Int       @default(0)
  lastClickedAt DateTime?

  @@id([ingredientId, region, hour])
  @@index([region, hour, clickCount])
  @@map("generic_ingredient_region_hour_stats")
}

// The ingredient composition of a "Ret" (dish; a Product with category
// "Retter"), with gram amount and share of the dish's total weight — used
// to estimate e.g. how much a bell pepper contributes to the dish's
// vitamin/mineral content. proportion/amountGrams is null when HelloFresh
// only states the amount in a non-weight unit (piece/dl/tsp/tbsp) — see
// docs/DECISIONS.md (2026-08-29).
model ProductIngredient {
  id           String     @id @default(cuid())
  product      Product    @relation(fields: [productId], references: [id])
  productId    String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId String
  rawAmount    Float
  rawUnit      String
  amountGrams  Float?
  proportion   Float?

  @@unique([productId, ingredientId])
  @@map("product_ingredients")
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
}

// Status for AI-found candidate images (generic raw-ingredient products
// without a brand only). Separate from ProductStatus: a product can be
// approved while its image is pending separate admin approval (see
// docs/ADMIN.md).
enum ImageStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model Barcode {
  code        String  @id
  product     Product @relation(fields: [productId], references: [id])
  productId   String
  blacklisted Boolean @default(false)

  @@map("barcodes")
}

// --- Custom dishes / recipes ---

model Dish {
  id             String    @id @default(cuid())
  name           String
  owner          User      @relation(fields: [ownerId], references: [id])
  ownerId        String
  category       Category? @relation(fields: [categoryId], references: [id])
  categoryId     String?
  externalSource String?
  createdAt      DateTime  @default(now())

  ingredients   DishIngredient[]
  registrations Registration[]
  favorites     Favorite[]
  forwards      Forward[]

  @@map("dishes")
}

model DishIngredient {
  id        String  @id @default(cuid())
  dish      Dish    @relation(fields: [dishId], references: [id])
  dishId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  grams     Float

  @@map("dish_ingredients")
}

// --- Registrations (snapshot principle) ---

model Registration {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  product   Product? @relation(fields: [productId], references: [id])
  productId String?
  dish      Dish?    @relation(fields: [dishId], references: [id])
  dishId    String?
  // Generisk, ikke-scannet ingrediens (grønt/frugt/kød uden emballage/brand,
  // se GenericIngredient og docs/DECISIONS.md 2026-09-19). Aldrig sat samtidig
  // med productId/dishId.
  genericIngredient   GenericIngredient? @relation(fields: [genericIngredientId], references: [id])
  genericIngredientId String?

  // Snapshot fields: the values at the time of registration, never changed
  // afterwards even if the product/dish is updated later.
  titleSnapshot   String
  kcalSnapshot    Float
  proteinSnapshot Float
  carbsSnapshot   Float
  fatSnapshot     Float
  amountGrams     Float

  // Optional extra-nutrition snapshots, only populated when the source
  // product has matching Product.nutritionExtra data (currently HelloFresh
  // recipes only, see docs/DECISIONS.md 2026-08-29) — null for every other
  // product/dish/AI-estimated registration. Used by the "Kulhydrattyper og
  // fibre"/"Mineraler" stat-card categories (src/lib/stat-cards.ts).
  sugarSnapshot     Float?
  fiberSnapshot     Float?
  saltSnapshot      Float?
  potassiumSnapshot Float?
  calciumSnapshot   Float?
  ironSnapshot      Float?

  // MyFitnessPal-style extended panel snapshots (2026-09-11), from the new
  // Product.*Per100g fields above — currently only populated for products
  // sourced from Open Food Facts (see src/lib/openFoodFacts.ts).
  saturatedFatSnapshot   Float?
  unsaturatedFatSnapshot Float?
  transFatSnapshot       Float?
  cholesterolSnapshot    Float?
  vitaminASnapshot       Float?
  vitaminCSnapshot       Float?

  createdAt DateTime @default(now())

  @@map("registrations")
}

// --- Favorites / library ---

model Favorite {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  product   Product? @relation(fields: [productId], references: [id])
  productId String?
  dish      Dish?    @relation(fields: [dishId], references: [id])
  dishId    String?
  createdAt DateTime @default(now())

  @@unique([userId, productId, dishId])
  @@map("favorites")
}

// --- Pointsystem (docs/DECISIONS.md 2026-09-02) ---
// Ledger frem for et cachet saldo-felt: saldoen er blot en SUM af
// PointsTransaction.amount for brugeren, hvilket giver et fuldt revisionsspor
// uden risiko for at et cachet felt driver ud af sync.

enum PointsReason {
  PRODUCT_APPROVED
  PRODUCT_INGREDIENTS_BONUS
  PRODUCT_PHOTOS_BONUS
  BUG_REPORT_APPROVED
  FRIEND_FORWARD_FULFILLED
  FRIEND_REFERRAL
  FREE_MONTH_REDEEMED
  // Kvalitetskontrol/billed-match (2026-09-19, docs/DECISIONS.md): brugeren
  // fik godkendt et erstatningsbillede for et lavt-confidence stregkode-/
  // næring-/ingrediensfoto, se ProductPhotoAward.
  QUALITY_CONTROL_PHOTO
}

model PointsTransaction {
  id          String       @id @default(cuid())
  user        User         @relation(fields: [userId], references: [id])
  userId      String
  reason      PointsReason
  amount      Int
  product     Product?     @relation(fields: [productId], references: [id])
  productId   String?
  bugReport   BugReport?   @relation(fields: [bugReportId], references: [id])
  bugReportId String?
  forward     Forward?     @relation(fields: [forwardId], references: [id])
  forwardId   String?
  createdAt   DateTime     @default(now())

  @@index([userId])
  @@map("points_transactions")
}

// --- Fejlrapporter ("Indberet fejl") ---

enum BugReportStatus {
  PENDING
  APPROVED
  REJECTED
}

// USER = the existing "Indberet fejl" flow (an actual user filed it, gets
// points on approval). AI = auto-filed by the AI product-recognition
// pipeline (docs/DECISIONS.md 2026-09-19) when it found something on the
// packaging it wasn't confident enough about (e.g. an alternative calorie
// display) to save/show without a human check — no user to credit points to.
enum BugReportSource {
  USER
  AI
}

model BugReport {
  id            String          @id @default(cuid())
  // Null only for source = AI (see BugReportSource above) — an AI-filed
  // report has no submitting user to attribute or award points to.
  user          User?           @relation(fields: [userId], references: [id])
  userId        String?
  source        BugReportSource @default(USER)
  description   String
  screenshotUrl String?
  status        BugReportStatus @default(PENDING)
  createdAt     DateTime        @default(now())
  resolvedAt    DateTime?

  // Sat når indberetningen kommer fra et konkret produkts "Indberet fejl"-link
  // (src/app/add/[id]/page.tsx), null for den generelle indgang under Profil.
  // Bruges til at forhindre at samme bruger indsender flere afventende
  // rettelser på samme produkt — se docs/DECISIONS.md 2026-09-19.
  product   Product? @relation(fields: [productId], references: [id])
  productId String?

  // Login-frit admin-godkendelseslink, samme mønster som Product.approvalToken.
  approvalToken    String?   @unique
  escalationSentAt DateTime?

  pointsTransactions PointsTransaction[]

  @@index([userId, productId])
  @@map("bug_reports")
}

// --- Besked automatisering (mail + push, docs/DECISIONS.md 2026-09-02) ---
// Faktisk afsendelse er forberedt (src/lib/mailer.ts, src/lib/push.ts), men
// aktiveres først når SMTP-/VAPID-miljøvariabler er udfyldt — se
// docs/DEPLOYMENT.md. Indtil da lægges beskeder blot i OutboundMessage-køen
// med status QUEUED.

enum MessageEvent {
  ACCOUNT_CREATED
  EMAIL_VERIFICATION
  PASSWORD_RESET
  PASSWORD_CHANGED
  START_WEIGHT_CHANGE
  FRIEND_REFERRAL
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  PRODUCT_ESCALATION_ADMIN
  BUG_REPORT_ESCALATION_ADMIN
  BUG_REPORT_RESOLVED
  BUG_REPORT_REJECTED
  POINTS_AWARDED
  FRIEND_FORWARD_RECEIVED
  FRIEND_INVITATION
  DOCTOR_SHARE_INVITATION
}

enum MessageChannel {
  EMAIL
  PUSH
  BOTH
}

// Admin-redigerbar skabelon pr. event ("Besked automatisering"-fanen).
// Seedet med en standardrække pr. MessageEvent ved migration.
model MessageTemplate {
  id        String         @id @default(cuid())
  event     MessageEvent   @unique
  channel   MessageChannel @default(EMAIL)
  enabled   Boolean        @default(true)
  subject   String
  bodyHtml  String
  pushTitle String?
  pushBody  String?
  updatedAt DateTime       @default(now()) @updatedAt

  @@map("message_templates")
}

enum OutboundStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

// Kø/log over alle udsendte/forsøgte beskeder. toEmail bruges når der ikke
// er en kendt bruger (fx admin-varsler til den faste admin-mail).
model OutboundMessage {
  id        String         @id @default(cuid())
  user      User?          @relation(fields: [userId], references: [id])
  userId    String?
  toEmail   String?
  event     MessageEvent
  channel   MessageChannel
  subject   String?
  bodyHtml  String?
  status    OutboundStatus @default(QUEUED)
  error     String?
  createdAt DateTime       @default(now())
  sentAt    DateTime?
  readAt    DateTime?

  @@index([status])
  @@index([userId, readAt])
  @@map("outbound_messages")
}

// Brugerstyrbare notifikationspræferencer pr. event (kun de events der ikke
// er transaktionelle, se src/lib/messaging.ts). Manglende række for en
// bruger/event betyder "til" (standarden nedenfor).
model NotificationPreference {
  id     String       @id @default(cuid())
  user   User         @relation(fields: [userId], references: [id])
  userId String
  event  MessageEvent
  email  Boolean      @default(true)
  push   Boolean      @default(true)

  @@unique([userId, event])
  @@map("notification_preferences")
}

// Web Push-abonnement (forberedt infrastruktur, aktiveres når VAPID-nøgler
// er udfyldt, se src/lib/push.ts).
model PushSubscription {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}

// --- Videresend ret/produkt til en ven ---

enum ForwardStatus {
  PENDING
  OPENED
  FULFILLED
  EXPIRED
}

enum ForwardKind {
  PRODUCT
  DISH
}

model Forward {
  id          String        @id @default(cuid())
  token       String        @unique @default(cuid())
  sender      User          @relation("ForwardSender", fields: [senderId], references: [id])
  senderId    String
  // docs/PRIVACY.md: modtageren gemmes ikke. Afsenderens navn og en delt
  // egen ret ligger krypteret i payload; nøglen findes kun i linkets
  // URL-fragment (#k=…), som serveren aldrig ser.
  payloadIv         String?
  payloadCiphertext String?
  kind        ForwardKind
  product     Product?      @relation(fields: [productId], references: [id])
  productId   String?
  dish        Dish?         @relation(fields: [dishId], references: [id])
  dishId      String?
  status      ForwardStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  openedAt    DateTime?
  fulfilledAt DateTime?

  pointsTransactions PointsTransaction[]

  @@index([senderId])
  @@map("forwards")
}

// --- Betaling / abonnement (docs/DECISIONS.md 2026-09-02) ---
// Udbyder-uafhængig forberedelse: der er endnu ikke en indløsningsaftale, så
// ingen konkret PSP er kaldt i kode endnu. provider/providerCustomerId/
// providerSubscriptionId er klar til at blive udfyldt, når en aftale
// (fx Reepay/Quickpay for MobilePay-understøttelse) er på plads.

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  TRIALING
  FREE_MONTH
  CANCELED
}

enum PaymentProvider {
  REEPAY
  QUICKPAY
  STRIPE
  MOBILEPAY_ONLINE
}

enum PaymentMethodBrand {
  VISA
  MASTERCARD
  APPLE_PAY
  GOOGLE_PAY
  MOBILEPAY
}

model Subscription {
  id                     String             @id @default(cuid())
  user                   User               @relation(fields: [userId], references: [id])
  userId                 String             @unique
  status                 SubscriptionStatus @default(INACTIVE)
  provider               PaymentProvider?
  providerCustomerId     String?
  providerSubscriptionId String?
  currentPeriodEnd       DateTime?
  // Optjente men endnu ikke forbrugte gratis måneder (indløst via 300
  // points, se PointsReason FREE_MONTH_REDEEMED), ventende på at blive
  // anvendt på næste faktureringsperiode.
  freeMonthsRemaining    Int                @default(0)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @default(now()) @updatedAt

  @@map("subscriptions")
}

// Gemte betalingsmetoder (kort/wallets). Selve kortoplysningerne opbevares
// aldrig her — kun det udbyderen returnerer til visning (mærke, sidste 4
// cifre, udløb) plus en reference-id til PSP'en for det faktiske kort/token.
model PaymentMethod {
  id                      String             @id @default(cuid())
  user                    User               @relation(fields: [userId], references: [id])
  userId                  String
  provider                PaymentProvider
  brand                   PaymentMethodBrand
  last4                   String?
  expiryMonth             Int?
  expiryYear              Int?
  isDefault               Boolean            @default(true)
  providerPaymentMethodId String?
  createdAt               DateTime           @default(now())

  @@index([userId])
  @@map("payment_methods")
}

// Gavekoder (docs/DECISIONS.md 2026-09-19): admin-oprettede engangskoder,
// der ved indløsning giver et fast antal dage Seriøs uden krav om nogen
// betalingsmetode — separat spor fra points→gratis måned
// (PointsReason.FREE_MONTH_REDEEMED ovenfor). Indløsning forlænger
// Subscription.currentPeriodEnd og sætter status til FREE_MONTH, samme
// "seriøs uden reelt betalende abonnement lige nu"-semantik som
// points-indløsning bruger, se src/lib/subscription.ts.
model GiftCode {
  id           String    @id @default(cuid())
  code         String    @unique
  durationDays Int
  redeemedBy   User?     @relation(fields: [redeemedById], references: [id])
  redeemedById String?
  redeemedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@map("gift_codes")
}

// --- Hello Doc: del fremgang med læge/diætist (docs/DECISIONS.md 2026-09-12) ---
// Ejeren (User) inviterer en e-mail (læge/diætist) til at se en skrivebeskyttet
// oversigt over udvalgte datakategorier. `token` er det unikke, login-frie
// link til selve visningen (samme mønster som Product.approvalToken) — den
// token-autentificerede eksterne visning er endnu ikke bygget (se
// docs/STATUS.md "Next work"); indtil da virker "Sådan ser det ud" kun som en
// forhåndsvisning af ejerens egne data.

enum DoctorShareStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
}

enum DoctorShareHistoryRange {
  LAST_7_DAYS
  LAST_MONTH
  LAST_YEAR
  ALL
}

model DoctorShare {
  id     String            @id @default(cuid())
  owner  User              @relation(fields: [ownerId], references: [id])
  ownerId String
  name   String
  email  String
  status DoctorShareStatus @default(PENDING)
  token  String            @unique @default(cuid())

  // Array of DoctorShareCategory keys (src/lib/doctor-share.ts) the owner has
  // opted to share with this recipient.
  categories   Json
  historyRange DoctorShareHistoryRange @default(ALL)

  sentAt DateTime @default(now())
  // Invitationens egen udløbsfrist (14 dage), før den er accepteret. Sat til
  // null når status bliver ACTIVE uden en separat aftalt adgangsperiode
  // ("Permanent" i oversigten) — der findes endnu ingen UI til at sætte en
  // kortere adgangsperiode efter accept.
  expiresAt  DateTime?
  acceptedAt DateTime?
  revokedAt  DateTime?

  @@index([ownerId])
  @@map("doctor_shares")
}

// --- Admin: brugerstøtte og revisionsspor ---

enum AdminAuditAction {
  IMPERSONATE_USER
  GDPR_FORGET_USER
}

// Revisionsspor for følsomme admin-handlinger ("log ind som bruger" og
// "ret til at blive glemt") — docs/DECISIONS.md 2026-09-02.
model AdminAuditLog {
  id           String           @id @default(cuid())
  admin        User             @relation("AdminAuditActor", fields: [adminId], references: [id])
  adminId      String
  action       AdminAuditAction
  targetUser   User?            @relation("AdminAuditTarget", fields: [targetUserId], references: [id])
  targetUserId String?
  createdAt    DateTime         @default(now())

  @@map("admin_audit_logs")
}

// ===================================================================
// Privacy-by-architecture (docs/PRIVACY.md, 2026-09-23)
// ===================================================================

// ---- Identitet: nøglekuverter og gendannelse ----

enum KeyEnvelopeKind {
  PASSKEY_PRF
  RECOVERY
}

// Brugerens hovednøgle (MK), krypteret på enheden. Serveren kan ikke åbne
// den: PASSKEY_PRF kræver passkeyens PRF-output, RECOVERY kræver både
// brugerens gendannelsesfil (F) og RecoveryShare.serverShare (S).
model KeyEnvelope {
  id         String          @id @default(cuid())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  kind       KeyEnvelopeKind
  // Passkey.credentialId for PASSKEY_PRF; null for RECOVERY.
  credentialId String?       @unique
  // PRF-salt (base64url) for PASSKEY_PRF.
  prfSalt    String?
  iv         String
  ciphertext String
  createdAt  DateTime        @default(now())

  @@index([userId, kind])
  @@map("key_envelopes")
}

// Hello Cals halvdel (S) af gendannelsesnøglen. fileHash = SHA-256(F), så
// serveren kan se, at brugeren har filen, uden at kende F.
model RecoveryShare {
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String   @id
  serverShare String
  fileHash    String
  createdAt   DateTime @default(now())

  @@map("recovery_shares")
}

enum RecoveryRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  EXPIRED
}

// Gendannelsessag: oprettes efter e-mailbekræftelse + upload af filens hash.
// Support bekræfter identiteten personligt og godkender; først da frigives S
// én gang via releaseTokenHash.
model RecoveryRequest {
  id               String                @id @default(cuid())
  user             User                  @relation("RecoveryRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  caseCode         String                @unique
  status           RecoveryRequestStatus @default(PENDING)
  releaseTokenHash String?               @unique
  approvedBy       User?                 @relation("RecoveryRequestApprover", fields: [approvedById], references: [id])
  approvedById     String?
  approvedAt       DateTime?
  expiresAt        DateTime
  completedAt      DateTime?
  createdAt        DateTime              @default(now())

  @@index([status])
  @@map("recovery_requests")
}

enum EmailLinkPurpose {
  SIGNUP
  RECOVERY
}

// Engangslinks sendt til en e-mail, som brugeren netop har tastet. Kun
// e-mailens hash gemmes — aldrig adressen.
model EmailLinkToken {
  id        String           @id @default(cuid())
  purpose   EmailLinkPurpose
  emailHash String
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([emailHash])
  @@map("email_link_tokens")
}

// ---- Boks: INGEN relation til User ----

// id = SHA-256(vaultToken). vaultToken afledes af brugerens hovednøgle, så
// serveren kan ikke finde en brugers boks ud fra kontoen.
model Vault {
  id           String        @id
  // X25519-offentlig nøgle (base64url) til forsegling af data til boksen.
  publicKey    String
  createdAt    DateTime      @default(now())
  // Opdateres højst én gang i døgnet; bruges til at rydde forældreløse bokse.
  lastAccessAt DateTime      @default(now())
  records      VaultRecord[]

  @@map("vaults")
}

// Én krypteret post. tag = HMAC af samlingsnavnet, recordId = klientens
// tilfældige ID. Indholdet er AES-256-GCM med AAD "<tag>/<recordId>".
model VaultRecord {
  id         String   @id @default(cuid())
  vault      Vault    @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  vaultId    String
  tag        String
  recordId   String
  iv         String
  ciphertext String
  deleted    Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@unique([vaultId, tag, recordId])
  @@index([vaultId, updatedAt])
  @@map("vault_records")
}

// Indbakke for data, som serveren forsegler til boksen (import fra
// integrationer). id = SHA-256(inboxToken); tokenet ligger i boksen.
model VaultInbox {
  id        String           @id
  publicKey String
  createdAt DateTime         @default(now())
  items     VaultInboxItem[]

  @@map("vault_inboxes")
}

model VaultInboxItem {
  id         String     @id @default(cuid())
  inbox      VaultInbox @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  inboxId    String
  epk        String
  iv         String
  ciphertext String
  createdAt  DateTime   @default(now())

  @@index([inboxId, createdAt])
  @@map("vault_inbox_items")
}

// ---- Invitér en ven uden gemt kobling (docs/PRIVACY.md "Sociale funktioner") ----

// Engangslink oprettet af afsenderen. Rækken SLETTES, når linket bruges, så
// der aldrig findes en række, der kobler afsender og modtager.
model InviteLink {
  id        String   @id @default(cuid())
  inviter   User     @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  inviterId String
  codeHash  String   @unique
  expiresAt DateTime

  @@index([inviterId])
  @@map("invite_links")
}

// Ventende belønning for én bruger. Afsender og modtager får hver sin række
// uden fælles ID; kun datoen (ikke tidspunktet) gemmes.
model InviteReward {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  eligibleOn  DateTime  @db.Date
  grantedAt   DateTime?

  @@index([eligibleOn])
  @@map("invite_rewards")
}

// --- Support: tidsbegrænset, brugerstyret dataadgang (docs/DECISIONS.md 2026-09-23) ---

// Brugeren bestemmer selv under Indstillinger → Support, hvilke datakategorier
// Support må se, og i hvilken periode. Aktiv kun når revokedAt er null og
// validFrom <= nu <= validUntil — kontrolleres server-side i
// src/lib/support-access.ts, aldrig kun i UI. Tilbagekaldelse sætter
// revokedAt (ingen fysisk sletning), så historikken bevares.
model SupportAccessGrant {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  // Start på Fra-dagen og slut på Til-dagen i Europe/Copenhagen.
  validFrom   DateTime
  validUntil  DateTime
  // { [SupportPermissionKey]: boolean } — kun kendte nøgler gemmes.
  permissions Json
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  supportRequests SupportRequest[]

  @@index([userId, revokedAt])
  @@index([validUntil])
  @@map("support_access_grants")
}

enum SupportRequestCategory {
  ACCOUNT
  DATA
  PRODUCTS
  PAYMENT
  BUG
  OTHER
}

enum SupportRequestStatus {
  OPEN
  RESOLVED
}

// "Kontakt os" fra Support-siden. Kobles til brugerens aktive grant på
// oprettelsestidspunktet (kan være null — man kan skrive uden at give adgang).
model SupportRequest {
  id             String                 @id @default(cuid())
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  category       SupportRequestCategory @default(OTHER)
  subject        String
  message        String
  supportGrant   SupportAccessGrant?    @relation(fields: [supportGrantId], references: [id], onDelete: SetNull)
  supportGrantId String?
  status         SupportRequestStatus   @default(OPEN)
  createdAt      DateTime               @default(now())
  resolvedAt     DateTime?

  @@index([status, createdAt])
  @@index([userId])
  @@map("support_requests")
}

// --- Normaliserede produkt-søgeparametre (docs/DECISIONS.md 2026-09-23) ---

// Hvor en normaliseret værdi kommer fra. Prioritet (høj → lav), se
// src/lib/product-nutrition-features.ts: MANUAL > PACKAGE_PERCENT >
// NUTRITION_LABEL = MANUFACTURER > EXTERNAL_DATABASE > DERIVED >
// AI_INTERPRETATION. En lavere kilde overskriver aldrig en højere.
enum ProductFeatureSource {
  MANUAL
  // Eksplicit procent i varedeklarationen/på forsiden (fx "41% fuldkorn").
  PACKAGE_PERCENT
  // Aflæst fra næringsdeklarationen (guidet foto-flow).
  NUTRITION_LABEL
  // Producent-/kædedata (REMA 1000-, HelloFresh-import).
  MANUFACTURER
  // Open Food Facts o.l.
  EXTERNAL_DATABASE
  // Deterministisk udledt (fx fiberPercent fra fiber pr. 100 g, nested %).
  DERIVED
  AI_INTERPRETATION
}

// Én række pr. produkt med de maskinlæsbare værdier, appen søger, filtrerer,
// scorer og laver statistik på. Rå tekst (Product.ingredientsText,
// Product.nutritionExtra, AiProductAnalysis.prediction) bevares separat som
// evidens, så alt kan genberegnes uden ny OCR. kcal/protein/kulhydrat/fedt/
// mættet fedt ligger allerede som kolonner på Product og dubleres ikke her.
// Procenter er altid 0–100 (ikke 0–1); ukendt er null, aldrig 0.
model ProductNutritionFeatures {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String  @unique

  // "100g" | "100ml" — grundlag for pr.100-værdierne. Procenter udledes
  // kun automatisk, når basis = 100g.
  basis String?

  // Sukkerarter fra næringsdeklarationen — IKKE tilsat sukker.
  sugarsPer100g   Float?
  sugarPercent    Float?
  sugarSource     ProductFeatureSource?
  sugarConfidence Float?

  fiberPer100g    Float?
  fiberPercent    Float?
  fiberSource     ProductFeatureSource?
  fiberConfidence Float?

  saltPer100g     Float?
  saltPercent     Float?
  saltSource      ProductFeatureSource?
  saltConfidence  Float?

  // Andel af HELE produktet, der er fuldkorn. isWholeGrain = null betyder
  // ukendt; false bruges kun, når ingredienslisten faktisk viser det.
  wholeGrainPercent    Float?
  isWholeGrain         Boolean?
  wholeGrainSource     ProductFeatureSource?
  wholeGrainConfidence Float?
  // Tekststumper fra deklarationen som begrundelse (admin/debug).
  wholeGrainEvidence   String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sugarsPer100g])
  @@index([sugarPercent])
  @@index([fiberPer100g])
  @@index([fiberPercent])
  @@index([saltPer100g])
  @@index([wholeGrainPercent])
  @@index([isWholeGrain])
  @@map("product_nutrition_features")
}
