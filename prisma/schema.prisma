generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Konto ---

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String
  role        Role     @default(USER)
  weightKg    Float?
  heightCm    Float?
  birthYear   Int?
  sex         Sex?
  createdAt   DateTime @default(now())

  // Admin-login (docs/ADMIN.md): kun sat for den ene administratorkonto,
  // oprettet via /admin/setup. Almindelige brugere har intet login endnu
  // (se docs/STATUS.md "Next work" #4) og har derfor begge felter null.
  passwordHash String?
  totpSecret   String?

  // Søvnmønster: standard sengetid/stå-op-tid, med mulighed for individuelle
  // tider pr. ugedag (SleepSchedule) til brugere med skiftende arbejdstider.
  defaultBedtime   String?
  defaultWakeTime  String?
  shiftWorkEnabled Boolean @default(false)

  // Skiftende arbejdstider: foretrækker brugeren at registrere arbejdstider
  // eller søvntider dagligt (spurgt i opsætningsguiden, kun relevant når
  // shiftWorkEnabled er sand).
  dailyLogPreference DailyLogPreference?

  // Vil brugeren kunne registrere arbejdstider direkte i kalenderen.
  workHoursInCalendarEnabled Boolean @default(false)

  // Har brugeren bedt om at få smartwatch-/sundhedsapp-import sat op.
  // Selve integrationen (Apple Health/Google Health Connect/Fitbit) er
  // separat, senere arbejde — dette felt husker kun ønsket fra guiden.
  healthImportRequested Boolean @default(false)

  // Fuldskærms-opsætningsguide ved første login (docs/UI.md "Onboarding og
  // hjælp"). onboardingStep er det næste trin der skal vises ved genoptagelse.
  onboardingStep          Int       @default(0)
  onboardingCompletedAt   DateTime?
  onboardingRemindLaterAt DateTime?
  onboardingDismissed     Boolean   @default(false)

  // Personlige indstillinger, ikke-standard "Vis allergener" (§ docs/STATUS.md
  // "Detaljer"-udvidelse): master-switch plus hvilke af de 14 EU-allergener
  // (se src/lib/allergens.ts) brugeren ønsker vist, hvis produktet indeholder
  // dem. Null = alle vises, når showAllergens er sand.
  showAllergens      Boolean @default(false)
  allergenVisibility Json?

  registrations  Registration[]
  favorites      Favorite[]
  dishes         Dish[]
  weightEntries  WeightEntry[]
  sleepSchedules SleepSchedule[]
  workShifts     WorkShift[]
  integrations   Integration[]
  activities     Activity[]

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

enum Sex {
  FEMALE
  MALE
}

enum DailyLogPreference {
  WORK_HOURS
  SLEEP_TIMES
}

// --- Vægtkalibrering ---
// Flere ugentlige vejninger under forskellige forhold (tøj, tidspunkt på
// dagen, toilet/mad) giver brugeren en fornemmelse af udsvinget i løbet af
// dagen, uden at kræve at man altid vejer sig nøgen for at kunne sammenligne.

model WeightEntry {
  id        String       @id @default(cuid())
  user      User         @relation(fields: [userId], references: [id])
  userId    String
  weightKg  Float
  clothed   Boolean      @default(true)
  shoes     ShoesState   @default(UNKNOWN)
  toilet    RelativeTime @default(UNKNOWN)
  meal      RelativeTime @default(UNKNOWN)
  timeOfDay TimeOfDay    @default(UNKNOWN)
  // Hvor vejningen kommer fra. En aktiv vægt-integration overskriver
  // automatisk seneste værdi (docs/SPECIFICATION.md:47) — scale-kilder kan
  // ikke vide tøj/sko/toilet/mad-tilstand, så de felter forbliver UNKNOWN/true
  // (standard) for rækker skrevet af en integration.
  source    WeightSource @default(MANUAL)
  note      String?
  weighedAt DateTime     @default(now())

  @@map("weight_entries")
}

enum RelativeTime {
  BEFORE
  AFTER
  UNKNOWN
}

enum TimeOfDay {
  MORNING
  EVENING
  UNKNOWN
}

enum ShoesState {
  ON
  OFF
  UNKNOWN
}

enum WeightSource {
  MANUAL
  FITBIT
  WITHINGS
}

// --- Søvnmønster og skiftende arbejdstider ---
// Individuelle sengetider/stå-op-tider pr. ugedag. Bruges kun når brugeren har
// slået "individuelle tider" til; ellers gælder User.defaultBedtime/-WakeTime.

model SleepSchedule {
  id       String @id @default(cuid())
  user     User   @relation(fields: [userId], references: [id])
  userId   String
  weekday  Int // 0 = mandag … 6 = søndag
  bedtime  String
  wakeTime String

  @@unique([userId, weekday])
  @@map("sleep_schedules")
}

// Arbejdsdage/-tider registreret direkte i kalenderen (evt. skiftehold/
// natarbejde). bedtime/wakeTime er en valgfri søvn-override for den dato,
// brugt i kalenderens søvnvisualisering når shiftWorkEnabled er slået til.

model WorkShift {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  date      DateTime @db.Date
  startTime String?
  endTime   String?
  bedtime   String?
  wakeTime  String?
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@map("work_shifts")
}

// --- Sundhedsintegrationer ---
// Apple Health/Google Health Connect er write-only (docs/SPECIFICATION.md §4)
// og har derfor ingen rækker her. Fitbit og Withings har rigtige OAuth-API'er
// og gemmer deres forbindelse i denne tabel; Garmin/Apple Health/Apple
// Watch/Google Health vises kun statisk i UI'en indtil en forbindelsesvej er
// valgt (companion-app eller tredjeparts-aggregator, se docs/DECISIONS.md).

model Integration {
  id           String              @id @default(cuid())
  user         User                @relation(fields: [userId], references: [id])
  userId       String
  provider     IntegrationProvider
  status       IntegrationStatus   @default(DISCONNECTED)
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  scope        String?
  connectedAt  DateTime?
  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime            @default(now())

  @@unique([userId, provider])
  @@map("integrations")
}

enum IntegrationProvider {
  FITBIT
  WITHINGS
  GARMIN
  APPLE_HEALTH
  GOOGLE_HEALTH
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

// Sportsregistreringer (træning/aktivitet), manuelt indtastet eller hentet fra
// en tilkoblet Integration. Bruges til kalenderens sportsikon/bonuskalorier
// og statistikkens sport-blokke (docs/SPECIFICATION.md §5 "Kaloriebank").
model Activity {
  id              String         @id @default(cuid())
  user            User           @relation(fields: [userId], references: [id])
  userId          String
  source          ActivitySource @default(MANUAL)
  sportType       String
  startedAt       DateTime
  durationMinutes Int
  caloriesBurned  Float
  createdAt       DateTime       @default(now())

  @@map("activities")
}

enum ActivitySource {
  MANUAL
  FITBIT
  GARMIN
}

// --- Fødevaredatabase ---

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  logoUrl   String?
  createdAt DateTime  @default(now())
  products  Product[]

  @@map("brands")
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
  dishes   Dish[]

  @@map("categories")
}

model Product {
  id               String                 @id @default(cuid())
  name             String
  brand            Brand?                 @relation(fields: [brandId], references: [id])
  brandId          String?
  category         Category?              @relation(fields: [categoryId], references: [id])
  categoryId       String?
  imageUrl         String?
  pendingImageUrl  String?
  imageStatus      ImageStatus            @default(NONE)
  kcalPer100g      Float
  proteinPer100g   Float
  carbsPer100g     Float
  fatPer100g       Float
  servingSizeGrams Float?
  ingredientsText  String?
  allergens        String[]               @default([])
  additives        String[]               @default([])
  externalSource   ExternalProductSource?
  externalId       String?
  sourceCheckedAt  DateTime?
  status           ProductStatus          @default(PENDING)
  discontinued     Boolean                @default(false)
  createdAt        DateTime               @default(now())

  barcodes        Barcode[]
  registrations   Registration[]
  favorites       Favorite[]
  dishIngredients DishIngredient[]

  @@index([externalSource, externalId])
  @@map("products")
}

enum ExternalProductSource {
  OPEN_FOOD_FACTS
  USDA
  FRIDA
}

// Reference-database over EU-godkendte E-tilsætningsstoffer (E100-E1521),
// importeret fra scripts/e-numre/data/e_numre.csv via scripts/e-numre/import_to_db.py.
model Additive {
  eNumber           String   @id @map("e_number")
  internationalName String   @map("international_name")
  danishName        String   @map("danish_name")
  function          String
  risks             String
  research          String
  link              String
  source            String
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("additives")
}

// Hvilken Frida-udgivelse (DTU's Figshare-datasæt) der senest er importeret,
// så frida-agent (scripts/frida-import) ikke genimporterer samme version.
model FridaImportState {
  id                Int      @id @default(autoincrement())
  figshareArticleId Int      @unique
  title             String
  importedAt        DateTime @default(now())

  @@map("frida_import_state")
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
}

// Status for AI-fundne kandidatbilleder (kun generiske råvarer uden brand).
// Adskilt fra ProductStatus: et produkt kan være godkendt, mens dets billede
// afventer separat admin-godkendelse (se docs/ADMIN.md).
enum ImageStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model Barcode {
  code        String  @id
  product     Product @relation(fields: [productId], references: [id])
  productId   String
  blacklisted Boolean @default(false)

  @@map("barcodes")
}

// --- Egne retter / opskrifter ---

model Dish {
  id             String    @id @default(cuid())
  name           String
  owner          User      @relation(fields: [ownerId], references: [id])
  ownerId        String
  category       Category? @relation(fields: [categoryId], references: [id])
  categoryId     String?
  externalSource String?
  createdAt      DateTime  @default(now())

  ingredients   DishIngredient[]
  registrations Registration[]
  favorites     Favorite[]

  @@map("dishes")
}

model DishIngredient {
  id        String  @id @default(cuid())
  dish      Dish    @relation(fields: [dishId], references: [id])
  dishId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  grams     Float

  @@map("dish_ingredients")
}

// --- Registreringer (snapshot-princip) ---

model Registration {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  product   Product? @relation(fields: [productId], references: [id])
  productId String?
  dish      Dish?    @relation(fields: [dishId], references: [id])
  dishId    String?

  // Snapshot-felter: værdierne på registreringstidspunktet, ændres aldrig
  // efterfølgende selvom produktet/retten opdateres senere.
  titleSnapshot   String
  kcalSnapshot    Float
  proteinSnapshot Float
  carbsSnapshot   Float
  fatSnapshot     Float
  amountGrams     Float

  createdAt DateTime @default(now())

  @@map("registrations")
}

// --- Favoritter / bibliotek ---

model Favorite {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  product   Product? @relation(fields: [productId], references: [id])
  productId String?
  dish      Dish?    @relation(fields: [dishId], references: [id])
  dishId    String?
  createdAt DateTime @default(now())

  @@unique([userId, productId, dishId])
  @@map("favorites")
}
