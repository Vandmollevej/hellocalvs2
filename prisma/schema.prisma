generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Konto ---

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String
  role        Role     @default(USER)
  weightKg    Float?
  heightCm    Float?
  birthYear   Int?
  sex         Sex?
  createdAt   DateTime @default(now())

  // Admin-login (docs/ADMIN.md): kun sat for den ene administratorkonto,
  // oprettet via /admin/setup. Almindelige brugere har intet login endnu
  // (se docs/STATUS.md "Next work" #4) og har derfor begge felter null.
  passwordHash String?
  totpSecret   String?

  // Almindelig bruger-tilmelding via /tilmeld (e-mail + adgangskode).
  // emailVerifiedAt sættes med det samme ved oprettelse, fordi der endnu
  // ikke er sat SMTP op til at sende en rigtig verifikationsmail — se
  // docs/STATUS.md "Next work" for opgaven om at eftermontere den rigtige
  // verifikationsmail, når SMTP findes.
  emailVerifiedAt DateTime?

  // Søvnmønster: standard sengetid/stå-op-tid, med mulighed for individuelle
  // tider pr. ugedag (SleepSchedule) til brugere med skiftende arbejdstider.
  defaultBedtime   String?
  defaultWakeTime  String?
  shiftWorkEnabled Boolean @default(false)

  // Skiftende arbejdstider: foretrækker brugeren at registrere arbejdstider
  // eller søvntider dagligt (spurgt i opsætningsguiden, kun relevant når
  // shiftWorkEnabled er sand).
  dailyLogPreference DailyLogPreference?

  // Vil brugeren kunne registrere arbejdstider direkte i kalenderen.
  workHoursInCalendarEnabled Boolean @default(false)

  // Har brugeren bedt om at få smartwatch-/sundhedsapp-import sat op.
  // Selve integrationen (Apple Health/Google Health Connect/Fitbit) er
  // separat, senere arbejde — dette felt husker kun ønsket fra guiden.
  healthImportRequested Boolean @default(false)

  // Fuldskærms-opsætningsguide ved første login (docs/UI.md "Onboarding og
  // hjælp"). onboardingStep er det næste trin der skal vises ved genoptagelse.
  onboardingStep          Int       @default(0)
  onboardingCompletedAt   DateTime?
  onboardingRemindLaterAt DateTime?
  onboardingDismissed     Boolean   @default(false)

  // Personlige indstillinger, ikke-standard "Vis allergener" (§ docs/STATUS.md
  // "Detaljer"-udvidelse): master-switch plus hvilke af de 14 EU-allergener
  // (se src/lib/allergens.ts) brugeren ønsker vist, hvis produktet indeholder
  // dem. Null = alle vises, når showAllergens er sand.
  showAllergens      Boolean @default(false)
  allergenVisibility Json?

  // Region (ISO 3166-1 alpha-2), bruges til at prioritere produktsøgeresultater
  // efter landets GS1-stregkodepræfiks (se src/lib/regions.ts). Danmark er
  // standard, da det er appens primære marked.
  region String @default("DK")

  // Billede-dagbog (docs/STATUS.md 2026-09-02): rent klient-lagret
  // foto-sammenligning i dag (localStorage), men adgangs-præferencen skal
  // være autoritativ i databasen. OS-niveau adgangskode-håndhævelse er en
  // fremtidig native-app-opgave — dette felt er kun den gemte brugerpræference.
  photoDiaryRequiresPasscode Boolean @default(false)

  // Kommunikationspræferencer (docs/STATUS.md 2026-09-02).
  wantsPushNotifications   Boolean @default(false)
  wantsUpdateNewsEmails    Boolean @default(false)
  wantsAdviceEmails        Boolean @default(false)
  wantsPartnerOffersEmails Boolean @default(false)

  // "Invitér en ven"-bogføring (docs/DECISIONS.md 2026-09-02): der findes
  // endnu ikke noget rigtigt invitations-/henvisningskode-flow, så dette er
  // kun datamodellen og optællingslogikken. freeMonthsCredited er loftet på
  // maks. 12 gratis måneder nogensinde.
  freeMonthsCredited Int @default(0)

  registrations    Registration[]
  favorites        Favorite[]
  dishes           Dish[]
  weightEntries    WeightEntry[]
  sleepSchedules   SleepSchedule[]
  workShifts       WorkShift[]
  integrations     Integration[]
  activities       Activity[]
  deviceTokens     DeviceToken[]
  healthMetrics    HealthMetric[]
  passkeys         Passkey[]
  referralsMade    Referral[]      @relation("ReferralsMade")
  referralReceived Referral?       @relation("ReferralReceived")

  @@map("users")
}

// "Invitér en ven"-bogføring. Der er ikke bygget noget rigtigt
// invitations-/henvisningskode-system endnu (intet konto-login-flow kan
// endnu attribuere hvem der inviterede hvem) — se docs/DECISIONS.md. Denne
// model er kun den fremtidige bogføring, klar til når et rigtigt
// invite-link/signup-attribution-mekanisme findes.
model Referral {
  id                   String    @id @default(cuid())
  referrer             User      @relation("ReferralsMade", fields: [referrerId], references: [id])
  referrerId           String
  referredUser         User      @relation("ReferralReceived", fields: [referredUserId], references: [id])
  referredUserId       String    @unique
  referredRegisteredAt DateTime
  rewardGrantedAt      DateTime?

  @@map("referrals")
}

enum Role {
  USER
  ADMIN
}

enum Sex {
  FEMALE
  MALE
}

enum DailyLogPreference {
  WORK_HOURS
  SLEEP_TIMES
}

// WebAuthn/passkey credentials for the admin login (docs/ADMIN.md) —
// alternative to password + TOTP, e.g. Face ID on iPhone via iCloud Keychain.
// A successful passkey assertion already proves possession + biometric user
// verification, so it grants a full session directly (no separate TOTP step).
model Passkey {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id])
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]  @default([])
  deviceType   String?
  backedUp     Boolean   @default(false)
  name         String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@map("passkeys")
}

// --- Vægtkalibrering ---
// Flere ugentlige vejninger under forskellige forhold (tøj, tidspunkt på
// dagen, toilet/mad) giver brugeren en fornemmelse af udsvinget i løbet af
// dagen, uden at kræve at man altid vejer sig nøgen for at kunne sammenligne.

model WeightEntry {
  id        String       @id @default(cuid())
  user      User         @relation(fields: [userId], references: [id])
  userId    String
  weightKg  Float
  clothed   Boolean      @default(true)
  shoes     ShoesState   @default(UNKNOWN)
  toilet    RelativeTime @default(UNKNOWN)
  meal      RelativeTime @default(UNKNOWN)
  timeOfDay TimeOfDay    @default(UNKNOWN)
  // Hvor vejningen kommer fra. En aktiv vægt-integration overskriver
  // automatisk seneste værdi (docs/SPECIFICATION.md:47) — scale-kilder kan
  // ikke vide tøj/sko/toilet/mad-tilstand, så de felter forbliver UNKNOWN/true
  // (standard) for rækker skrevet af en integration.
  source    WeightSource @default(MANUAL)
  note      String?
  weighedAt DateTime     @default(now())

  @@map("weight_entries")
}

enum RelativeTime {
  BEFORE
  AFTER
  UNKNOWN
}

enum TimeOfDay {
  MORNING
  EVENING
  UNKNOWN
}

enum ShoesState {
  ON
  OFF
  UNKNOWN
}

enum WeightSource {
  MANUAL
  FITBIT
  WITHINGS
  APPLE_HEALTH
  GOOGLE_HEALTH
}

// --- Søvnmønster og skiftende arbejdstider ---
// Individuelle sengetider/stå-op-tider pr. ugedag. Bruges kun når brugeren har
// slået "individuelle tider" til; ellers gælder User.defaultBedtime/-WakeTime.

model SleepSchedule {
  id       String @id @default(cuid())
  user     User   @relation(fields: [userId], references: [id])
  userId   String
  weekday  Int // 0 = mandag … 6 = søndag
  bedtime  String
  wakeTime String

  @@unique([userId, weekday])
  @@map("sleep_schedules")
}

// Arbejdsdage/-tider registreret direkte i kalenderen (evt. skiftehold/
// natarbejde). bedtime/wakeTime er en valgfri søvn-override for den dato,
// brugt i kalenderens søvnvisualisering når shiftWorkEnabled er slået til.

model WorkShift {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  date      DateTime @db.Date
  startTime String?
  endTime   String?
  bedtime   String?
  wakeTime  String?
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@map("work_shifts")
}

// --- Sundhedsintegrationer ---
// Fitbit og Withings har rigtige OAuth-API'er og gemmer deres forbindelse i
// Integration-tabellen. Garmin afventer separat partnergodkendelse og vises
// kun statisk i UI'en. Apple Health/Google Health Connect kan ikke tilgås fra
// en webapp overhovedet (HealthKit/Health Connect er native-only) — i stedet
// er der forberedt en generisk indtags-vej (DeviceToken + HealthMetric) som
// en fremtidig native companion-app kan sende data til; se
// docs/HEALTHKIT_COMPANION.md og docs/DECISIONS.md (2026-08-28).

model Integration {
  id           String              @id @default(cuid())
  user         User                @relation(fields: [userId], references: [id])
  userId       String
  provider     IntegrationProvider
  status       IntegrationStatus   @default(DISCONNECTED)
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  scope        String?
  connectedAt  DateTime?
  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime            @default(now())

  @@unique([userId, provider])
  @@map("integrations")
}

enum IntegrationProvider {
  FITBIT
  WITHINGS
  GARMIN
  APPLE_HEALTH
  GOOGLE_HEALTH
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

// Sportsregistreringer (træning/aktivitet), manuelt indtastet eller hentet fra
// en tilkoblet Integration. Bruges til kalenderens sportsikon/bonuskalorier
// og statistikkens sport-blokke (docs/SPECIFICATION.md §5 "Kaloriebank").
model Activity {
  id              String         @id @default(cuid())
  user            User           @relation(fields: [userId], references: [id])
  userId          String
  source          ActivitySource @default(MANUAL)
  sportType       String
  startedAt       DateTime
  durationMinutes Int
  caloriesBurned  Float
  createdAt       DateTime       @default(now())

  @@map("activities")
}

enum ActivitySource {
  MANUAL
  FITBIT
  GARMIN
  APPLE_HEALTH
  GOOGLE_HEALTH
}

// Et personligt, langtlevende adgangstoken en fremtidig native companion-app
// (iOS/HealthKit eller Android/Health Connect) autentificerer sig med mod
// POST /api/integrations/healthkit/ingest. Kun tokenets hash gemmes — den
// rå værdi vises én gang ved oprettelse, ligesom et personligt API-nøgle-mønster.
model DeviceToken {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  tokenHash  String    @unique
  label      String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@map("device_tokens")
}

// Generiske sundhedsmålinger fra en tilkoblet native companion-app, for
// datatyper der ikke passer ind i WeightEntry/Activity (skridt, puls, søvn,
// kropsfedt, højde, BMI m.m.). Se docs/HEALTHKIT_COMPANION.md.
model HealthMetric {
  id         String             @id @default(cuid())
  user       User               @relation(fields: [userId], references: [id])
  userId     String
  source     HealthMetricSource
  type       HealthMetricType
  value      Float
  recordedAt DateTime
  createdAt  DateTime           @default(now())

  @@unique([userId, source, type, recordedAt])
  @@map("health_metrics")
}

enum HealthMetricSource {
  APPLE_HEALTH
  GOOGLE_HEALTH
}

enum HealthMetricType {
  STEPS
  ACTIVE_ENERGY_KCAL
  RESTING_ENERGY_KCAL
  HEART_RATE_BPM
  SLEEP_MINUTES
  BODY_FAT_PERCENT
  HEIGHT_CM
  BMI
  WATER_ML
}

// --- Fødevaredatabase ---

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  logoUrl   String?
  createdAt DateTime  @default(now())
  products  Product[]

  @@map("brands")
}

// Rene katalogiseringskategorier (ikke vist i UI'en) der gør det lettere at
// scanne/filtrere fødevaredatabasen internt: "Retter" (fx HelloFresh-opskrifter
// importeret som Product), "Menuer" (ugentlige menu-grupperinger, endnu ikke
// populeret — HelloFresh eksponerer ikke en stabil uge-gruppering offentligt),
// "Ingredienser" (den delte Ingredient-katalog, se nedenfor) og "Færdigmad"
// (købte færdigretter, endnu ikke auto-tagget). Se docs/DECISIONS.md
// (2026-08-29, HelloFresh-import).
model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
  dishes   Dish[]

  @@map("categories")
}

model Product {
  id               String                 @id @default(cuid())
  name             String
  brand            Brand?                 @relation(fields: [brandId], references: [id])
  brandId          String?
  category         Category?              @relation(fields: [categoryId], references: [id])
  categoryId       String?
  imageUrl         String?
  pendingImageUrl  String?
  imageStatus      ImageStatus            @default(NONE)
  kcalPer100g      Float
  proteinPer100g   Float
  carbsPer100g     Float
  fatPer100g       Float
  servingSizeGrams Float?
  ingredientsText  String?
  allergens        String[]               @default([])
  additives        String[]               @default([])
  externalSource   ExternalProductSource?
  externalId       String?
  sourceCheckedAt  DateTime?
  // Ekstra næringsværdier der ikke passer i de faste per-100g-felter ovenfor
  // (fx HelloFresh-opskrifters fiber/sukker/salt/kalium/calcium/jern pr.
  // serveringsstørrelse). Se docs/DECISIONS.md (2026-08-29).
  nutritionExtra   Json?
  status           ProductStatus          @default(PENDING)
  discontinued     Boolean                @default(false)
  createdAt        DateTime               @default(now())

  barcodes        Barcode[]
  registrations   Registration[]
  favorites       Favorite[]
  dishIngredients DishIngredient[]
  ingredients     ProductIngredient[]
  images          ProductImage[]

  @@index([externalSource, externalId])
  @@map("products")
}

// Up to 3 additional photos alongside the primary Product.imageUrl (e.g. the
// other sides of a milk carton or box). Admin-managed only (docs/ADMIN.md,
// "Merge og øvrige billeder") — the image-agent's automated suggestion flow
// still targets pendingImageUrl/imageStatus above, unrelated to this table.
model ProductImage {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

enum ExternalProductSource {
  OPEN_FOOD_FACTS
  USDA
  FRIDA
  HELLOFRESH
}

// Reference-database over EU-godkendte E-tilsætningsstoffer (E100-E1521),
// importeret fra scripts/e-numre/data/e_numre.csv via scripts/e-numre/import_to_db.py.
model Additive {
  eNumber           String   @id @map("e_number")
  internationalName String   @map("international_name")
  danishName        String   @map("danish_name")
  function          String
  risks             String
  research          String
  link              String
  source            String
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("additives")
}

// Hvilken Frida-udgivelse (DTU's Figshare-datasæt) der senest er importeret,
// så frida-agent (scripts/frida-import) ikke genimporterer samme version.
model FridaImportState {
  id                Int      @id @default(autoincrement())
  figshareArticleId Int      @unique
  title             String
  importedAt        DateTime @default(now())

  @@map("frida_import_state")
}

// Delt ingrediens-billedkatalog, hentet af hellofresh-agent
// (scripts/hellofresh-import) fra HelloFreshs offentlige opskriftssider.
// Adskilt fra Product: det er billeder/metadata til visning på tværs af
// appen (fx "denne ret indeholder: [ikon] Gulerod"), ikke en selvstændig
// logbar fødevare — Frida-importerede Product-rækker er stadig den eneste
// kilde til egentlige næringsværdier for rå ingredienser. Se
// docs/DECISIONS.md (2026-08-29).
model Ingredient {
  id             String   @id @default(cuid())
  name           String
  slug           String?
  externalSource String? // "HELLOFRESH"
  externalId     String?  @unique
  imageUrl       String?
  createdAt      DateTime @default(now())

  products ProductIngredient[]

  @@map("ingredients")
}

// Ingrediens-sammensætningen af en "Ret" (Product med category "Retter"),
// med gram-mængde og andel af rettens samlede vægt — bruges til at estimere
// fx hvor meget en peberfrugt bidrager til rettens vitamin-/mineralindhold.
// proportion/amountGrams er null når HelloFresh kun oplyser mængden i en
// ikke-vægt-enhed (stk/dl/tsk/spsk) — se docs/DECISIONS.md (2026-08-29).
model ProductIngredient {
  id           String     @id @default(cuid())
  product      Product    @relation(fields: [productId], references: [id])
  productId    String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId String
  rawAmount    Float
  rawUnit      String
  amountGrams  Float?
  proportion   Float?

  @@unique([productId, ingredientId])
  @@map("product_ingredients")
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
}

// Status for AI-fundne kandidatbilleder (kun generiske råvarer uden brand).
// Adskilt fra ProductStatus: et produkt kan være godkendt, mens dets billede
// afventer separat admin-godkendelse (se docs/ADMIN.md).
enum ImageStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model Barcode {
  code        String  @id
  product     Product @relation(fields: [productId], references: [id])
  productId   String
  blacklisted Boolean @default(false)

  @@map("barcodes")
}

// --- Egne retter / opskrifter ---

model Dish {
  id             String    @id @default(cuid())
  name           String
  owner          User      @relation(fields: [ownerId], references: [id])
  ownerId        String
  category       Category? @relation(fields: [categoryId], references: [id])
  categoryId     String?
  externalSource String?
  createdAt      DateTime  @default(now())

  ingredients   DishIngredient[]
  registrations Registration[]
  favorites     Favorite[]

  @@map("dishes")
}

model DishIngredient {
  id        String  @id @default(cuid())
  dish      Dish    @relation(fields: [dishId], references: [id])
  dishId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  grams     Float

  @@map("dish_ingredients")
}

// --- Registreringer (snapshot-princip) ---

model Registration {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  product   Product? @relation(fields: [productId], references: [id])
  productId String?
  dish      Dish?    @relation(fields: [dishId], references: [id])
  dishId    String?

  // Snapshot-felter: værdierne på registreringstidspunktet, ændres aldrig
  // efterfølgende selvom produktet/retten opdateres senere.
  titleSnapshot   String
  kcalSnapshot    Float
  proteinSnapshot Float
  carbsSnapshot   Float
  fatSnapshot     Float
  amountGrams     Float

  createdAt DateTime @default(now())

  @@map("registrations")
}

// --- Favoritter / bibliotek ---

model Favorite {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  product   Product? @relation(fields: [productId], references: [id])
  productId String?
  dish      Dish?    @relation(fields: [dishId], references: [id])
  dishId    String?
  createdAt DateTime @default(now())

  @@unique([userId, productId, dishId])
  @@map("favorites")
}
