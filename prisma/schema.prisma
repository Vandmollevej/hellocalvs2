generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Account ---

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String
  role        Role     @default(USER)
  weightKg    Float?
  heightCm    Float?
  birthYear   Int?
  sex         Sex?
  createdAt   DateTime @default(now())

  // Admin login (docs/ADMIN.md): only set for the single administrator
  // account, created via /admin/setup. Regular users have no login yet
  // (see docs/STATUS.md "Next work" #4), so both fields are null for them.
  passwordHash String?
  totpSecret   String?

  // Regular user signup via /signup (email + password).
  // emailVerifiedAt is set immediately on creation, because SMTP is not
  // yet set up to send a real verification email — see docs/STATUS.md
  // "Next work" for the task of retrofitting the real verification
  // email once SMTP exists.
  emailVerifiedAt DateTime?

  // Sleep pattern: default bedtime/wake time, with the option of
  // individual times per weekday (SleepSchedule) for users with shifting
  // work hours.
  defaultBedtime   String?
  defaultWakeTime  String?
  shiftWorkEnabled Boolean @default(false)

  // Shifting work hours: does the user prefer to log work hours or sleep
  // times daily (asked in the setup wizard, only relevant when
  // shiftWorkEnabled is true).
  dailyLogPreference DailyLogPreference?

  // Whether the user wants to be able to log work hours directly in the
  // calendar.
  workHoursInCalendarEnabled Boolean @default(false)

  // Has the user asked to have smartwatch/health app import set up.
  // The integration itself (Apple Health/Google Health Connect/Fitbit) is
  // separate, later work — this field only remembers the wish from the
  // wizard.
  healthImportRequested Boolean @default(false)

  // Full-screen setup wizard at first login (docs/UI.md "Onboarding and
  // help"). onboardingStep is the next step to show on resume.
  onboardingStep          Int       @default(0)
  onboardingCompletedAt   DateTime?
  onboardingRemindLaterAt DateTime?
  onboardingDismissed     Boolean   @default(false)

  // Personal settings, non-default "Show allergens" (see docs/STATUS.md
  // "Details" extension): master switch plus which of the 14 EU allergens
  // (see src/lib/allergens.ts) the user wants shown when a product contains
  // them. Null = all are shown, when showAllergens is true.
  showAllergens      Boolean @default(false)
  allergenVisibility Json?

  // Region (ISO 3166-1 alpha-2), used to prioritize product search results
  // by the country's GS1 barcode prefix (see src/lib/regions.ts). Denmark is
  // the default, since it's the app's primary market.
  region String @default("DK")

  // UI language (i18n, added 2026-09-02): "da" (default) or "en". Every
  // existing user defaults to Danish so nothing changes unless they open the
  // language setting in Settings.
  locale String @default("da")

  // Billede-dagbog (docs/STATUS.md 2026-09-02): rent klient-lagret
  // foto-sammenligning i dag (localStorage), men adgangs-præferencen skal
  // være autoritativ i databasen. OS-niveau adgangskode-håndhævelse er en
  // fremtidig native-app-opgave — dette felt er kun den gemte brugerpræference.
  photoDiaryRequiresPasscode Boolean @default(false)

  // Kommunikationspræferencer (docs/STATUS.md 2026-09-02).
  wantsPushNotifications   Boolean @default(false)
  wantsUpdateNewsEmails    Boolean @default(false)
  wantsAdviceEmails        Boolean @default(false)
  wantsPartnerOffersEmails Boolean @default(false)

  // "Invitér en ven"-bogføring (docs/DECISIONS.md 2026-09-02): der findes
  // endnu ikke noget rigtigt invitations-/henvisningskode-flow, så dette er
  // kun datamodellen og optællingslogikken. freeMonthsCredited er loftet på
  // maks. 12 gratis måneder nogensinde.
  freeMonthsCredited Int @default(0)

  registrations    Registration[]
  favorites        Favorite[]
  dishes           Dish[]
  weightEntries    WeightEntry[]
  sleepSchedules   SleepSchedule[]
  workShifts       WorkShift[]
  integrations     Integration[]
  activities       Activity[]
  deviceTokens     DeviceToken[]
  healthMetrics    HealthMetric[]
  passkeys         Passkey[]
  referralsMade    Referral[]      @relation("ReferralsMade")
  referralReceived Referral?       @relation("ReferralReceived")

  @@map("users")
}

// "Invitér en ven"-bogføring. Der er ikke bygget noget rigtigt
// invitations-/henvisningskode-system endnu (intet konto-login-flow kan
// endnu attribuere hvem der inviterede hvem) — se docs/DECISIONS.md. Denne
// model er kun den fremtidige bogføring, klar til når et rigtigt
// invite-link/signup-attribution-mekanisme findes.
model Referral {
  id                   String    @id @default(cuid())
  referrer             User      @relation("ReferralsMade", fields: [referrerId], references: [id])
  referrerId           String
  referredUser         User      @relation("ReferralReceived", fields: [referredUserId], references: [id])
  referredUserId       String    @unique
  referredRegisteredAt DateTime
  rewardGrantedAt      DateTime?

  @@map("referrals")
}

enum Role {
  USER
  ADMIN
}

enum Sex {
  FEMALE
  MALE
}

enum DailyLogPreference {
  WORK_HOURS
  SLEEP_TIMES
}

// WebAuthn/passkey credentials for the admin login (docs/ADMIN.md) —
// alternative to password + TOTP, e.g. Face ID on iPhone via iCloud Keychain.
// A successful passkey assertion already proves possession + biometric user
// verification, so it grants a full session directly (no separate TOTP step).
model Passkey {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id])
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]  @default([])
  deviceType   String?
  backedUp     Boolean   @default(false)
  name         String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@map("passkeys")
}

// --- Weight calibration ---
// Several weekly weigh-ins under different conditions (clothing, time of
// day, toilet/food) give the user a sense of the fluctuation throughout the
// day, without requiring them to always weigh themselves naked in order to
// compare.

model WeightEntry {
  id        String       @id @default(cuid())
  user      User         @relation(fields: [userId], references: [id])
  userId    String
  weightKg  Float
  clothed   Boolean      @default(true)
  shoes     ShoesState   @default(UNKNOWN)
  toilet    RelativeTime @default(UNKNOWN)
  meal      RelativeTime @default(UNKNOWN)
  timeOfDay TimeOfDay    @default(UNKNOWN)
  // Where the weigh-in comes from. An active weight integration automatically
  // overwrites the latest value (docs/SPECIFICATION.md:47) — scale sources
  // can't know the clothing/shoes/toilet/food state, so those fields stay
  // UNKNOWN/true (default) for rows written by an integration.
  source    WeightSource @default(MANUAL)
  note      String?
  weighedAt DateTime     @default(now())

  @@map("weight_entries")
}

enum RelativeTime {
  BEFORE
  AFTER
  UNKNOWN
}

enum TimeOfDay {
  MORNING
  EVENING
  UNKNOWN
}

enum ShoesState {
  ON
  OFF
  UNKNOWN
}

enum WeightSource {
  MANUAL
  FITBIT
  WITHINGS
  APPLE_HEALTH
  GOOGLE_HEALTH
}

// --- Sleep pattern and shifting work hours ---
// Individual bedtimes/wake times per weekday. Only used when the user has
// enabled "individual times"; otherwise User.defaultBedtime/-WakeTime applies.

model SleepSchedule {
  id       String @id @default(cuid())
  user     User   @relation(fields: [userId], references: [id])
  userId   String
  weekday  Int // 0 = Monday … 6 = Sunday
  bedtime  String
  wakeTime String

  @@unique([userId, weekday])
  @@map("sleep_schedules")
}

// Work days/hours logged directly in the calendar (e.g. shift work/
// night work). bedtime/wakeTime is an optional sleep override for that
// date, used in the calendar's sleep visualization when shiftWorkEnabled
// is on.

model WorkShift {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  date      DateTime @db.Date
  startTime String?
  endTime   String?
  bedtime   String?
  wakeTime  String?
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@map("work_shifts")
}

// --- Health integrations ---
// Fitbit and Withings have real OAuth APIs and store their connection in
// the Integration table. Garmin is pending separate partner approval and is
// only shown statically in the UI. Apple Health/Google Health Connect can't
// be accessed from a web app at all (HealthKit/Health Connect are
// native-only) — instead a generic ingestion path (DeviceToken +
// HealthMetric) has been prepared, which a future native companion app can
// send data to; see docs/HEALTHKIT_COMPANION.md and docs/DECISIONS.md
// (2026-08-28).

model Integration {
  id           String              @id @default(cuid())
  user         User                @relation(fields: [userId], references: [id])
  userId       String
  provider     IntegrationProvider
  status       IntegrationStatus   @default(DISCONNECTED)
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  scope        String?
  connectedAt  DateTime?
  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime            @default(now())

  @@unique([userId, provider])
  @@map("integrations")
}

enum IntegrationProvider {
  FITBIT
  WITHINGS
  GARMIN
  APPLE_HEALTH
  GOOGLE_HEALTH
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

// Sports/activity logs, entered manually or fetched from a connected
// Integration. Used for the calendar's sports icon/bonus calories and the
// statistics page's sport blocks (docs/SPECIFICATION.md §5 "Calorie bank").
model Activity {
  id              String         @id @default(cuid())
  user            User           @relation(fields: [userId], references: [id])
  userId          String
  source          ActivitySource @default(MANUAL)
  sportType       String
  startedAt       DateTime
  durationMinutes Int
  caloriesBurned  Float
  createdAt       DateTime       @default(now())

  @@map("activities")
}

enum ActivitySource {
  MANUAL
  FITBIT
  GARMIN
  APPLE_HEALTH
  GOOGLE_HEALTH
}

// A personal, long-lived access token a future native companion app
// (iOS/HealthKit or Android/Health Connect) authenticates with against
// POST /api/integrations/healthkit/ingest. Only the token's hash is
// stored — the raw value is shown once at creation, like a personal
// API-key pattern.
model DeviceToken {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  tokenHash  String    @unique
  label      String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@map("device_tokens")
}

// Generic health metrics from a connected native companion app, for
// data types that don't fit in WeightEntry/Activity (steps, heart rate,
// sleep, body fat, height, BMI, etc.). See docs/HEALTHKIT_COMPANION.md.
model HealthMetric {
  id         String             @id @default(cuid())
  user       User               @relation(fields: [userId], references: [id])
  userId     String
  source     HealthMetricSource
  type       HealthMetricType
  value      Float
  recordedAt DateTime
  createdAt  DateTime           @default(now())

  @@unique([userId, source, type, recordedAt])
  @@map("health_metrics")
}

enum HealthMetricSource {
  APPLE_HEALTH
  GOOGLE_HEALTH
}

enum HealthMetricType {
  STEPS
  ACTIVE_ENERGY_KCAL
  RESTING_ENERGY_KCAL
  HEART_RATE_BPM
  SLEEP_MINUTES
  BODY_FAT_PERCENT
  HEIGHT_CM
  BMI
  WATER_ML
}

// --- Food database ---

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  logoUrl   String?
  createdAt DateTime  @default(now())
  products  Product[]

  @@map("brands")
}

// Pure cataloging categories (not shown in the UI) that make it easier to
// scan/filter the food database internally: "Retter" (dishes, e.g. HelloFresh
// recipes imported as Product), "Menuer" (menus, weekly menu groupings, not
// yet populated — HelloFresh doesn't expose a stable weekly grouping
// publicly), "Ingredienser" (ingredients, the shared Ingredient catalog, see
// below) and "Færdigmad" (ready meals, purchased ready meals, not yet
// auto-tagged). See docs/DECISIONS.md (2026-08-29, HelloFresh import).
model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
  dishes   Dish[]

  @@map("categories")
}

model Product {
  id               String                 @id @default(cuid())
  name             String
  brand            Brand?                 @relation(fields: [brandId], references: [id])
  brandId          String?
  category         Category?              @relation(fields: [categoryId], references: [id])
  categoryId       String?
  imageUrl         String?
  pendingImageUrl  String?
  imageStatus      ImageStatus            @default(NONE)
  kcalPer100g      Float
  proteinPer100g   Float
  carbsPer100g     Float
  fatPer100g       Float
  servingSizeGrams Float?
  ingredientsText  String?
  allergens        String[]               @default([])
  additives        String[]               @default([])
  externalSource   ExternalProductSource?
  externalId       String?
  sourceCheckedAt  DateTime?
  // Extra nutrition values that don't fit in the fixed per-100g fields above
  // (e.g. HelloFresh recipes' fiber/sugar/salt/potassium/calcium/iron per
  // serving size). See docs/DECISIONS.md (2026-08-29).
  nutritionExtra   Json?
  status           ProductStatus          @default(PENDING)
  discontinued     Boolean                @default(false)
  createdAt        DateTime               @default(now())

  barcodes        Barcode[]
  registrations   Registration[]
  favorites       Favorite[]
  dishIngredients DishIngredient[]
  ingredients     ProductIngredient[]
  images          ProductImage[]

  @@index([externalSource, externalId])
  @@map("products")
}

// Up to 3 additional photos alongside the primary Product.imageUrl (e.g. the
// other sides of a milk carton or box). Admin-managed only (docs/ADMIN.md,
// "Merge og øvrige billeder") — the image-agent's automated suggestion flow
// still targets pendingImageUrl/imageStatus above, unrelated to this table.
model ProductImage {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

enum ExternalProductSource {
  OPEN_FOOD_FACTS
  USDA
  FRIDA
  HELLOFRESH
}

// Reference database of EU-approved E-number additives (E100-E1521),
// imported from scripts/e-numre/data/e_numre.csv via scripts/e-numre/import_to_db.py.
model Additive {
  eNumber           String   @id @map("e_number")
  internationalName String   @map("international_name")
  danishName        String   @map("danish_name")
  function          String
  risks             String
  research          String
  link              String
  source            String
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("additives")
}

// Which Frida release (DTU's Figshare dataset) was most recently imported,
// so frida-agent (scripts/frida-import) doesn't re-import the same version.
model FridaImportState {
  id                Int      @id @default(autoincrement())
  figshareArticleId Int      @unique
  title             String
  importedAt        DateTime @default(now())

  @@map("frida_import_state")
}

// Shared ingredient image catalog, fetched by hellofresh-agent
// (scripts/hellofresh-import) from HelloFresh's public recipe pages.
// Separate from Product: it's images/metadata for display across the
// app (e.g. "this dish contains: [icon] Carrot"), not a standalone
// loggable food item — Frida-imported Product rows are still the only
// source for actual nutrition values of raw ingredients. See
// docs/DECISIONS.md (2026-08-29).
model Ingredient {
  id             String   @id @default(cuid())
  name           String
  slug           String?
  externalSource String? // "HELLOFRESH"
  externalId     String?  @unique
  imageUrl       String?
  createdAt      DateTime @default(now())

  products ProductIngredient[]

  @@map("ingredients")
}

// The ingredient composition of a "Ret" (dish; a Product with category
// "Retter"), with gram amount and share of the dish's total weight — used
// to estimate e.g. how much a bell pepper contributes to the dish's
// vitamin/mineral content. proportion/amountGrams is null when HelloFresh
// only states the amount in a non-weight unit (piece/dl/tsp/tbsp) — see
// docs/DECISIONS.md (2026-08-29).
model ProductIngredient {
  id           String     @id @default(cuid())
  product      Product    @relation(fields: [productId], references: [id])
  productId    String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId String
  rawAmount    Float
  rawUnit      String
  amountGrams  Float?
  proportion   Float?

  @@unique([productId, ingredientId])
  @@map("product_ingredients")
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
}

// Status for AI-found candidate images (generic raw-ingredient products
// without a brand only). Separate from ProductStatus: a product can be
// approved while its image is pending separate admin approval (see
// docs/ADMIN.md).
enum ImageStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model Barcode {
  code        String  @id
  product     Product @relation(fields: [productId], references: [id])
  productId   String
  blacklisted Boolean @default(false)

  @@map("barcodes")
}

// --- Custom dishes / recipes ---

model Dish {
  id             String    @id @default(cuid())
  name           String
  owner          User      @relation(fields: [ownerId], references: [id])
  ownerId        String
  category       Category? @relation(fields: [categoryId], references: [id])
  categoryId     String?
  externalSource String?
  createdAt      DateTime  @default(now())

  ingredients   DishIngredient[]
  registrations Registration[]
  favorites     Favorite[]

  @@map("dishes")
}

model DishIngredient {
  id        String  @id @default(cuid())
  dish      Dish    @relation(fields: [dishId], references: [id])
  dishId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  grams     Float

  @@map("dish_ingredients")
}

// --- Registrations (snapshot principle) ---

model Registration {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  product   Product? @relation(fields: [productId], references: [id])
  productId String?
  dish      Dish?    @relation(fields: [dishId], references: [id])
  dishId    String?

  // Snapshot fields: the values at the time of registration, never changed
  // afterwards even if the product/dish is updated later.
  titleSnapshot   String
  kcalSnapshot    Float
  proteinSnapshot Float
  carbsSnapshot   Float
  fatSnapshot     Float
  amountGrams     Float

  createdAt DateTime @default(now())

  @@map("registrations")
}

// --- Favorites / library ---

model Favorite {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  product   Product? @relation(fields: [productId], references: [id])
  productId String?
  dish      Dish?    @relation(fields: [dishId], references: [id])
  dishId    String?
  createdAt DateTime @default(now())

  @@unique([userId, productId, dishId])
  @@map("favorites")
}
