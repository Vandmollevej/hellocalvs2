# Copy this file to .env.production on the Synology server.
# Never commit the real file.
HELLOCAL_IMAGE=ghcr.io/vandmollevej/hellocalvs2
HELLOCAL_TAG=latest
HELLOCAL_BIND_ADDRESS=0.0.0.0
HELLOCAL_HTTP_PORT=3100

POSTGRES_DB=hellocal
POSTGRES_USER=hellocal
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://hellocal:replace-with-the-url-encoded-password@db:5432/hellocal?schema=public

# USDA FoodData Central fallback for products not found in Open Food Facts.
# Create at https://fdc.nal.usda.gov/api-key-signup and keep the real key secret.
USDA_FDC_API_KEY=replace-with-a-fooddata-central-api-key

# Stemme-skærmens AI-tolkning af madvarer (se src/app/api/ai/interpret-meal).
OPENAI_API_KEY=replace-with-an-openai-api-key

# Vision-model til det guidede barcode-first produktoprettelsesflow
# (analyze-product-front/extract-ingredients-photo/extract-nutrition-v2, se
# src/lib/product-ai.ts). Genbruger OPENAI_API_KEY ovenfor. Egen env-variabel
# så modellen kan A/B-testes uden kodeændring, jf.
# HelloCal_OpenAI_ProductRecognition_Handoff_2026-09-16/08_OPENAI_API_NOTES.md.
OPENAI_PRODUCT_VISION_MODEL=gpt-5.6-terra

# Passio Nutrition-AI: madvare-genkendelse fra tallerken-foto i kamera-flowet
# (mode=meal, se src/lib/passio.ts og src/app/api/ai/analyze-meal-photo).
# HelloFresh-opskrifter bruger IKKE Passio — de matches lokalt mod egne
# produkter (src/app/api/ai/recognize-hellofresh). Nøgle hentes på
# https://accounts.passiolife.com.
PASSIO_API_KEY=replace-with-a-passio-nutrition-ai-key

# Billede-agent (finder produktbilleder via Google Custom Search, se scripts/image-agent)
GOOGLE_API_KEY=replace-with-a-google-cloud-api-key
GOOGLE_CSE_ID=replace-with-a-programmable-search-engine-id
IMAGE_AGENT_POLL_INTERVAL_SECONDS=300

# Frida-agent (importerer nye udgivelser af DTU's danske fødevaredatabase
# automatisk fra data.dtu.dk, se scripts/frida-import). Ingen API-nøgle nødvendig.
FRIDA_AGENT_POLL_INTERVAL_SECONDS=86400

# HelloFresh-agent (katalogiserer HelloFresh Danmarks offentlige opskrifter —
# billede, energifordeling, ingrediens-sammensætning — via deres crawler-
# sanktionerede sitemap, se scripts/hellofresh-import). Ingen login eller
# API-nøgle nødvendig. Kort poll-interval er med vilje: allerede
# importerede/uændrede opskrifter springes billigt over (sammenlignet mod
# sitemap'ets lastmod), så det kun er det første, store indhentningsløb der
# reelt bruger tid.
HELLOFRESH_AGENT_POLL_INTERVAL_SECONDS=120
HELLOFRESH_AGENT_BATCH_SIZE=30

# Admin-login (products.hellocal.packroff.dk, se docs/ADMIN.md). Signerer
# admin-sessionscookien (JWT). Generér med fx `openssl rand -base64 48` og
# hold den hemmelig — alle admin-sessioner ugyldiggøres, hvis den ændres.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Brugersessioner (almindelige brugere, passkey-login). Samme generering som
# ovenfor. Falder tilbage til ADMIN_SESSION_SECRET, hvis den ikke er sat.
USER_SESSION_SECRET=replace-with-a-long-random-secret

# docs/PRIVACY.md: hemmelig pepper til HMAC af brugeres e-mail (e-mail gemmes
# aldrig i klartekst). Mindst 32 tegn, fx `openssl rand -base64 48`.
# MÅ ALDRIG ÆNDRES, når der findes brugere — så kan ingen længere findes via
# e-mail ved gendannelse.
EMAIL_HASH_PEPPER=replace-with-a-long-random-secret

# Midlertidigt login med e-mail + kode (docs/DECISIONS.md 2026-09-24), indtil
# rigtigt adgangskode-login er bygget. Tom = slået fra.
CODE_LOGIN_EMAIL=
CODE_LOGIN_CODE=

# Offentlig base-URL til links i mails (tilmelding og gendannelse).
APP_BASE_URL=https://hellocal.packroff.dk

# SMTP til mails. Uden SMTP kan brugere ikke oprette konto eller gendanne
# adgang i produktion (mails sendes direkte og gemmes aldrig).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Hello Cal <no-reply@hellocal.packroff.dk>

# Integrationer (Indstillinger > Integrationer, se src/lib/integrations).
# Base-URL'en appen selv kører på — bruges til at bygge OAuth-redirect-URI'er.
INTEGRATIONS_REDIRECT_BASE_URL=https://hellocal.packroff.dk

# Fitbit: opret en app på https://dev.fitbit.com/apps/new med
# redirect-URI'en <INTEGRATIONS_REDIRECT_BASE_URL>/api/integrations/fitbit/callback
FITBIT_CLIENT_ID=replace-with-a-fitbit-client-id
FITBIT_CLIENT_SECRET=replace-with-a-fitbit-client-secret

# Withings (smart-vægt): opret en app på https://developer.withings.com/dashboard
# med redirect-URI'en <INTEGRATIONS_REDIRECT_BASE_URL>/api/integrations/withings/callback
WITHINGS_CLIENT_ID=replace-with-a-withings-client-id
WITHINGS_CLIENT_SECRET=replace-with-a-withings-client-secret

# Oprettelses-app (docs/OPRETTELSES-APP.md) — egen container "scan-app".
# Adressen invitationslinks peger på (Cloudflare Tunnel -> NAS-port 3101).
SCAN_APP_BASE_URL=https://scanhellocal.packroff.dk
SCAN_APP_HTTP_PORT=3101
# Egne hemmeligheder anbefales (ellers bruges ADMIN_SESSION_SECRET).
# SCAN_PII_KEY krypterer medarbejderes CPR/bank og må aldrig ændres bagefter.
SCAN_SESSION_SECRET=replace-with-a-long-random-secret
SCAN_PII_KEY=replace-with-a-long-random-secret
# Valgfri: butiksnavn ud fra koordinater (Google Places API (New)).
GOOGLE_PLACES_API_KEY=

# Logo-robot (docs/LOGO-AGENT.md): Google Vision-nøgle (Cloud Vision API).
# Tom = GOOGLE_API_KEY bruges.
GOOGLE_VISION_API_KEY=
LOGO_AGENT_RUN_HOUR=3
LOGO_AGENT_BATCH_SIZE=25
# Valgfri: sæt kun, hvis Withings-appen er registreret med en anden URI, fx
# https://hellocal.packroff.dk/api/withings/callback (den virker også).
WITHINGS_REDIRECT_URI=

# Google Health API (cloud, afløser Fitbit Web API): OAuth-klient (Web) i Google
# Cloud med Google Health API slået til. Redirect-URI:
# <INTEGRATIONS_REDIRECT_BASE_URL>/api/integrations/google-health/callback
# eller https://hellocal.packroff.dk/api/google-health/callback (sæt så
# GOOGLE_HEALTH_REDIRECT_URI til den).
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REDIRECT_URI=

# Strava: https://www.strava.com/settings/api. "Authorization Callback Domain"
# = hellocal.packroff.dk (stien er <base>/api/integrations/strava/callback).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Polar Flow (AccessLink): https://admin.polaraccesslink.com med redirect-URI
# <INTEGRATIONS_REDIRECT_BASE_URL>/api/integrations/polar/callback
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
