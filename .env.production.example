# Copy this file to .env.production on the Synology server.
# Never commit the real file.
HELLOCAL_IMAGE=ghcr.io/vandmollevej/hellocalvs2
HELLOCAL_TAG=latest
HELLOCAL_BIND_ADDRESS=0.0.0.0
HELLOCAL_HTTP_PORT=3100

POSTGRES_DB=hellocal
POSTGRES_USER=hellocal
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://hellocal:replace-with-the-url-encoded-password@db:5432/hellocal?schema=public
