# Copy this file to .env.production on the Synology server.
# Never commit the real file.
HELLOCAL_IMAGE=ghcr.io/vandmollevej/hellocalvs2
HELLOCAL_TAG=latest
HELLOCAL_BIND_ADDRESS=0.0.0.0
HELLOCAL_HTTP_PORT=3100

POSTGRES_DB=hellocal
POSTGRES_USER=hellocal
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://hellocal:replace-with-the-url-encoded-password@db:5432/hellocal?schema=public

# USDA FoodData Central fallback for products not found in Open Food Facts.
# Create at https://fdc.nal.usda.gov/api-key-signup and keep the real key secret.
USDA_FDC_API_KEY=replace-with-a-fooddata-central-api-key

# Stemme-skærmens AI-tolkning af madvarer (se src/app/api/ai/interpret-meal).
OPENAI_API_KEY=replace-with-an-openai-api-key

# Billede-agent (finder produktbilleder via Google Custom Search, se scripts/image-agent)
GOOGLE_API_KEY=replace-with-a-google-cloud-api-key
GOOGLE_CSE_ID=replace-with-a-programmable-search-engine-id
IMAGE_AGENT_POLL_INTERVAL_SECONDS=300

# Frida-agent (importerer nye udgivelser af DTU's danske fødevaredatabase
# automatisk fra data.dtu.dk, se scripts/frida-import). Ingen API-nøgle nødvendig.
FRIDA_AGENT_POLL_INTERVAL_SECONDS=86400

# HelloFresh-agent (katalogiserer HelloFresh Danmarks offentlige opskrifter —
# billede, energifordeling, ingrediens-sammensætning — via deres crawler-
# sanktionerede sitemap, se scripts/hellofresh-import). Ingen login eller
# API-nøgle nødvendig. Kort poll-interval er med vilje: allerede
# importerede/uændrede opskrifter springes billigt over (sammenlignet mod
# sitemap'ets lastmod), så det kun er det første, store indhentningsløb der
# reelt bruger tid.
HELLOFRESH_AGENT_POLL_INTERVAL_SECONDS=120
HELLOFRESH_AGENT_BATCH_SIZE=30

# Admin-login (products.hellocal.packroff.dk, se docs/ADMIN.md). Signerer
# admin-sessionscookien (JWT). Generér med fx `openssl rand -base64 48` og
# hold den hemmelig — alle admin-sessioner ugyldiggøres, hvis den ændres.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Integrationer (Indstillinger > Integrationer, se src/lib/integrations).
# Base-URL'en appen selv kører på — bruges til at bygge OAuth-redirect-URI'er.
INTEGRATIONS_REDIRECT_BASE_URL=https://hellocal.packroff.dk

# Fitbit: opret en app på https://dev.fitbit.com/apps/new med
# redirect-URI'en <INTEGRATIONS_REDIRECT_BASE_URL>/api/integrations/fitbit/callback
FITBIT_CLIENT_ID=replace-with-a-fitbit-client-id
FITBIT_CLIENT_SECRET=replace-with-a-fitbit-client-secret

# Withings (smart-vægt): opret en app på https://developer.withings.com/dashboard
# med redirect-URI'en <INTEGRATIONS_REDIRECT_BASE_URL>/api/integrations/withings/callback
WITHINGS_CLIENT_ID=replace-with-a-withings-client-id
WITHINGS_CLIENT_SECRET=replace-with-a-withings-client-secret
